---
/**
 * SiteFooter — brand + compact site nav (critique polish, 2026-08-12).
 *
 * Still on-brand (ink/hairline/mono), but tighter than the Webflow port:
 * one nav column instead of a stranded Legal column with a single link,
 * contact email for agency trust, cleaner copyright row.
 *
 * Blog remains gated behind features.blog (docs/enable-blog.md).
 */
import { Image } from 'astro:assets'
import logo from '../assets/images/LC-SITE-NAV.png'
import { features } from '../config'

export interface Props {
  currentPath: string
}

const { currentPath } = Astro.props

const pageLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/team', label: 'Team' },
  { href: '/projects', label: 'Projects' },
  ...(features.blog ? [{ href: '/blog', label: 'Blog' }] : []),
  { href: '/contact', label: 'Contact' },
  { href: '/privacy-policy', label: 'Privacy' },
]

const isCurrent = (path: string) => currentPath === path
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="page-padding">
    <div class="container-xxlarge">
      <div class="line" aria-hidden="true"></div>
      <div class="footer-main">
        <div class="footer-brand">
          <a href="/" class="footer-logo-link" aria-current={isCurrent('/') ? 'page' : undefined}>
            <Image src={logo} alt="Leviathan Core" width={220} class="footer-logo-image" />
          </a>
          <p class="footer-tagline">
            Influencer marketing for gaming brands — connecting the right creators with the right audiences since
            2017.
          </p>
          <div class="footer-social">
            <a
              href="https://twitter.com/leviacore"
              target="_blank"
              rel="noopener noreferrer"
              class="badge small link"
              aria-label="Leviathan Core on Twitter"
            >
              <span class="text-meta-small" aria-hidden="true">TW</span>
            </a>
            <a
              href="https://www.linkedin.com/company/leviathan-core/"
              target="_blank"
              rel="noopener noreferrer"
              class="badge small link"
              aria-label="Leviathan Core on LinkedIn"
            >
              <span class="text-meta-small" aria-hidden="true">IN</span>
            </a>
          </div>
        </div>

        <div class="footer-meta">
          <div class="footer-column">
            <p class="footer-label">Explore</p>
            <nav class="footer-nav" aria-label="Footer">
              {
                pageLinks.map((link) => (
                  <a
                    href={link.href}
                    class="footer-nav-item-link"
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                ))
              }
            </nav>
          </div>
          <div class="footer-column">
            <p class="footer-label">Contact</p>
            <a class="footer-contact-link" href="mailto:development@leviacore.com">development@leviacore.com</a>
            <a class="footer-nav-item-link footer-contact-cta" href="/contact">Let's make it happen</a>
          </div>
        </div>
      </div>
      <div class="line" aria-hidden="true"></div>
      <div class="footer-bottom">
        <p class="footer-copy">© Leviathan Core, LLC {year}. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-main {
    display: grid;
    grid-template-columns: minmax(14rem, 1.2fr) minmax(16rem, 1fr);
    gap: var(--space-xl);
    padding-block: var(--space-lg);
    align-items: start;
  }

  @media screen and (max-width: 767px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 22rem;
  }

  .footer-logo-link {
    display: inline-block;
    width: fit-content;
  }

  .footer-logo-image {
    display: block;
    width: min(220px, 70%);
    height: auto;
  }

  .footer-tagline {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-base);
    line-height: var(--lh-loose);
    color: var(--color-ink);
  }

  .footer-social {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-xxs);
  }

  .footer-social :global(.badge) {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  .footer-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  @media screen and (max-width: 479px) {
    .footer-meta {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer-label {
    margin: 0 0 var(--space-xxs);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-nav-item-link,
  .footer-contact-link {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    width: fit-content;
  }

  .footer-contact-link {
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--fs-sm);
    font-family: var(--font-body);
    word-break: break-word;
  }

  .footer-contact-cta {
    margin-top: var(--space-xs);
  }

  .footer-nav-item-link:hover,
  .footer-contact-link:hover,
  .footer-contact-cta:hover {
    text-decoration: underline;
  }

  .footer-nav-item-link[aria-current='page'] {
    text-decoration: underline;
  }

  .footer-bottom {
    padding-block: var(--space-sm);
  }

  .footer-copy {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>

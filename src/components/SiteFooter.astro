---
/**
 * SiteFooter — editorial colophon: brand + explore / legal columns.
 */
import { Image } from 'astro:assets'
import logo from '../assets/images/LC-SITE-NAV.png'
import { features } from '../config'

export interface Props {
  currentPath: string
}

const { currentPath } = Astro.props

const pageLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/team', label: 'Team' },
  { href: '/projects', label: 'Projects' },
  ...(features.blog ? [{ href: '/blog', label: 'Blog' }] : []),
  { href: '/contact', label: 'Contact us' },
]

const legalLinks = [
  { href: '/privacy-policy', label: 'Privacy Policy' },
]

const isCurrent = (path: string) => currentPath === path
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="page-padding">
    <div class="container-xxlarge">
      <div class="footer-grid">
        <div class="footer-grid-left">
          <div>
            <Image src={logo} alt="Leviathan Core" width={280} class="footer-logo-image" />
            <p class="footer-tagline">
              Proudly connecting brands and audiences with influencer marketing expertise in the
              gaming space since 2017.
            </p>
          </div>
          <div class="subnav small">
            <a
              href="https://x.com/leviacore"
              target="_blank"
              rel="noopener noreferrer"
              class="badge small link"
              aria-label="Leviathan Core on X"
            >
              <span class="text-meta-small" aria-hidden="true">X</span>
            </a>
            <a
              href="https://www.linkedin.com/company/leviathan-core/"
              target="_blank"
              rel="noopener noreferrer"
              class="badge small link"
              aria-label="Leviathan Core on LinkedIn"
            >
              <span class="text-meta-small" aria-hidden="true">IN</span>
            </a>
          </div>
        </div>
        <div class="footer-grid-right">
          <div class="footer-column">
            <h3 class="footer-column-label">Pages</h3>
            <nav class="footer-nav" aria-label="Footer">
              {
                pageLinks.map((link) => (
                  <a
                    href={link.href}
                    class="footer-nav-item-link"
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                ))
              }
            </nav>
          </div>
          <div class="footer-column">
            <h3 class="footer-column-label">Legal</h3>
            <nav class="footer-nav" aria-label="Legal">
              {
                legalLinks.map((link) => (
                  <a href={link.href} class="footer-nav-item-link">
                    {link.label}
                  </a>
                ))
              }
            </nav>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="subnav center">
          <p class="text-meta">© Leviathan Core, LLC {year}</p>
          <p class="text-meta">- ALL RIGHTS RESERVED</p>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(2rem, 6vw, 4rem);
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(14rem, 1.15fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-block: clamp(2.75rem, 7vw, 5rem) clamp(2rem, 5vw, 3.5rem);
  }

  @media screen and (max-width: 991px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .footer-grid-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer-logo-image {
    height: auto;
    width: clamp(160px, 18vw, 240px);
    margin-bottom: var(--space-sm);
  }

  .footer-tagline {
    max-width: 28ch;
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .subnav {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .subnav.small {
    gap: var(--space-xs);
  }

  .subnav.center {
    justify-content: center;
  }

  .footer-grid-right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-column-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    opacity: 0.55;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-nav-item-link {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.78;
    transition: opacity var(--duration-fast) var(--ease-editorial);
  }

  .footer-nav-item-link:hover,
  .footer-nav-item-link[aria-current='page'] {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer-bottom {
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  .footer-bottom .text-meta {
    font-family: var(--font-body);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    display: inline;
    opacity: 0.55;
  }
</style>

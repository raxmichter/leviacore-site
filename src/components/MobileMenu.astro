---
/**
 * MobileMenu — full-viewport nav drawer (≤991px).
 */
import Button from './Button.astro'
import { features } from '../config'

export interface Props {
  currentPath: string
}

const { currentPath } = Astro.props

const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/team', label: 'Team' },
  ...(features.blog ? [{ href: '/blog', label: 'Blog' }] : []),
  { href: '/contact', label: 'Contact' },
]

const isCurrent = (path: string) => currentPath === path
---

<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="page-padding">
    <div class="container-xxlarge">
      <div class="mobile-menu-wrapper">
        <nav class="mobile-menu-nav" aria-label="Mobile">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="mobile-menu-nav-link"
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                <span class="mobile-menu-nav-text">{link.label}</span>
              </a>
            ))
          }
          <Button href="/contact" class="mobile-menu-cta" ariaCurrent={isCurrent('/contact')}>
            Let's make it happen
          </Button>
          <div class="mobile-menu-social">
            <a
              href="https://twitter.com/leviacore"
              class="badge small link"
              aria-label="Leviathan Core on Twitter"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="text-meta-small" aria-hidden="true">Tw</span>
            </a>
            <a
              href="https://www.linkedin.com/company/leviathan-core/"
              class="badge small link"
              aria-label="Leviathan Core on LinkedIn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="text-meta-small" aria-hidden="true">IN</span>
            </a>
          </div>
        </nav>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: var(--color-bg);
    overflow-y: auto;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 300ms linear,
      transform 300ms cubic-bezier(0.165, 0.84, 0.44, 1),
      display 300ms allow-discrete;
  }

  .mobile-menu:not([hidden]) {
    display: block;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 300ms linear,
      transform 500ms cubic-bezier(0.165, 0.84, 0.44, 1),
      display 500ms allow-discrete;
  }

  @starting-style {
    .mobile-menu:not([hidden]) {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .mobile-menu-wrapper {
    padding-block: clamp(5rem, 18vh, 7rem) var(--space-xl);
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu-nav-link {
    display: block;
    padding-block: 1.1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .mobile-menu-nav-text {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 2.75rem);
    letter-spacing: var(--ls-display);
    line-height: var(--lh-tighter);
  }

  .mobile-menu-nav-link[aria-current='page'] .mobile-menu-nav-text {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .mobile-menu-cta {
    margin-top: 2rem;
    align-self: flex-start;
  }

  .mobile-menu-social {
    display: flex;
    gap: var(--space-xs);
    margin-top: 1.5rem;
  }

  .mobile-menu-social :global(.badge) {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }
</style>

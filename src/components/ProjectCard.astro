---
/**
 * ProjectCard — curated case-study row for /projects and /blog.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import SectionHeading from './SectionHeading.astro'
import Button from './Button.astro'

interface Props {
  title: string
  description: string
  tags: string[]
  image: ImageMetadata
  imageAlt: string
  href: string
  ctaText?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
  /** Alternate media/text order for editorial rhythm */
  mediaFirst?: boolean
}

const {
  title,
  description,
  tags,
  image,
  imageAlt,
  href,
  ctaText = 'View Project',
  headingLevel = 'h2',
  mediaFirst = false,
} = Astro.props
---

<article class:list={['project-card', { 'media-first': mediaFirst }]} data-reveal>
  <div class="project-card-content">
    <div class="project-card-text">
      <a href={href} class="project-card-title-link">
        <SectionHeading as={headingLevel} variant="h1" uppercase>{title}</SectionHeading>
      </a>
      <p class="project-card-description">{description}</p>
      {
        tags.length > 0 && (
          <ul class="project-card-tags">
            {tags.map((tag) => (
              <li>
                <span class="text-meta-link">{tag}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <Button href={href} variant="secondary">{ctaText}</Button>
  </div>
  <a href={href} class="project-card-image-wrapper" aria-hidden="true" tabindex="-1">
    <Image src={image} alt={imageAlt} class="image-cover" />
  </a>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3.25rem);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 3.75rem);
  }

  .project-card.media-first .project-card-image-wrapper {
    order: -1;
  }

  @media screen and (max-width: 991px) {
    .project-card {
      grid-template-columns: 1fr;
    }
    .project-card-image-wrapper,
    .project-card.media-first .project-card-image-wrapper {
      order: -1;
    }
  }

  .project-card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }

  @media screen and (max-width: 767px) {
    .project-card-content :global(.button) {
      width: 100%;
    }
  }

  .project-card-title-link {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .project-card-title-link:hover :global(.heading) {
      text-decoration: underline;
      text-underline-offset: 0.12em;
    }
  }

  .project-card-description {
    margin: 0.85rem 0 0;
    max-width: 36ch;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .text-meta-link {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0.75;
    pointer-events: none;
  }

  .project-card-image-wrapper {
    display: block;
    overflow: hidden;
    height: min(38vw, 720px);
    background: var(--color-paper-deep);
  }

  @media screen and (max-width: 991px) {
    .project-card-image-wrapper {
      height: auto;
      aspect-ratio: 16 / 9;
      width: 100%;
    }
  }

  .project-card-image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms var(--ease-editorial);
  }

  @media (hover: hover) and (min-width: 992px) {
    .project-card:hover .project-card-image-wrapper :global(img) {
      transform: scale(1.03);
    }
  }
</style>

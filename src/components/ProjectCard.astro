---
/**
 * ProjectCard — the projects.html case-study card.
 *
 * Source: components.md #21 and §6. The 5 real case studies never exported (Webflow CMS
 * content is excluded from static exports), so this is built strictly to the card *shape*
 * documented from the empty `w-dyn-list` template — no case-study content is invented here.
 *
 * Shape: title (h2, styled `.heading-h1.text-uppercase`, also the card's link target) +
 * description + a repeating list of service/tag links + a "View Project" CTA (secondary
 * `Button` variant, source: bare `.button`, no `.primary`) on the left; a linked cover image
 * on the right.
 *
 * `href` is accepted generically — the source's `detail_*.html` project pages are explicitly
 * out of scope for this migration per build-context/PROGRESS.md, so where this href actually
 * points is a decision for whichever phase builds the destination, not for this component.
 *
 * Grid column ratio is not documented in tokens.md (this grid isn't among the 1px-divider
 * grids listed in §5f), so a plain equal-width two-column grid is used on desktop, collapsing
 * to one column at ≤991 — consistent with the site-wide "grids collapse to 1 column at ≤991"
 * pattern tokens.md documents elsewhere. Flagged as an assumption, not a ported value.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import SectionHeading from './SectionHeading.astro'
import Button from './Button.astro'

interface Props {
  title: string
  description: string
  tags: string[]
  image: ImageMetadata
  imageAlt: string
  href: string
  ctaText?: string
  headingLevel?: 'h1' | 'h2' | 'h3'
}

const { title, description, tags, image, imageAlt, href, ctaText = 'View Project', headingLevel = 'h2' } =
  Astro.props
---

<article class="project-card">
  <div class="project-card-content">
    <div class="project-card-text">
      <a href={href} class="project-card-title-link">
        <SectionHeading as={headingLevel} variant="h1" uppercase>{title}</SectionHeading>
      </a>
      <p class="project-card-description">{description}</p>
      {
        tags.length > 0 && (
          <ul class="project-card-tags">
            {tags.map((tag) => (
              <li>
                <span class="text-meta-link">{tag}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <Button href={href} variant="secondary">{ctaText}</Button>
  </div>
  <a href={href} class="project-card-image-wrapper" aria-hidden="true" tabindex="-1">
    <Image src={image} alt={imageAlt} class="image-cover" />
  </a>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }
  @media screen and (max-width: 991px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }
  .project-card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .project-card-title-link {
    color: inherit;
    text-decoration: none;
  }
  .project-card-description {
    margin: var(--space-sm) 0 0;
    max-width: var(--width-sm);
    font-family: var(--font-body);
  }
  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    margin: var(--space-md) 0 0;
    padding: 0;
    list-style: none;
  }
  .text-meta-link {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .project-card-image-wrapper {
    display: block;
    border-radius: var(--radius-card);
    overflow: hidden;
    /* tokens.md §5f: height 32vw, max-height 660px base → 45vw @<=991 */
    height: 32vw;
    max-height: 660px;
  }
  @media screen and (max-width: 991px) {
    .project-card-image-wrapper {
      height: 45vw;
    }
  }
  .project-card-image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

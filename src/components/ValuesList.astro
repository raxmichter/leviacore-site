---
/**
 * ValuesList — numbered values chapter (home + team).
 */
import { Image } from 'astro:assets'
import portrait from '../assets/images/LC-Head.png'
import SectionHeading from './SectionHeading.astro'

interface ValueItem {
  number: string
  title: string
  description: string
}

interface Props {
  headingText?: string
  items: ValueItem[]
  portraitAlt: string
}

const { headingText = 'the values at our core.', items, portraitAlt } = Astro.props
---

<section class="section-home-values" data-reveal>
  <div class="page-padding">
    <div class="container-xxlarge">
      <div class="heading-row">
        <SectionHeading as="h2" variant="display-lg" uppercase>{headingText}</SectionHeading>
      </div>
      <div class="home-values-grid">
        <div class="portrait-wrapper">
          <Image src={portrait} alt={portraitAlt} class="image-cover" />
        </div>
        <div class="home-values-grid-right">
          {
            items.map((item) => (
              <div class="home-values-item">
                <span class="item-number" aria-hidden="true">{item.number}</span>
                <div>
                  <SectionHeading as="h3" uppercase class="item-title">{item.title}</SectionHeading>
                  <p class="item-description">{item.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-home-values {
    padding-block: var(--section-pad-y);
  }

  .heading-row {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    max-width: 18ch;
  }

  .home-values-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media screen and (max-width: 991px) {
    .home-values-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .portrait-wrapper {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-paper-deep);
  }

  .portrait-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 991px) {
    .portrait-wrapper {
      max-block-size: 22rem;
      aspect-ratio: 16 / 10;
    }
  }

  .home-values-grid-right {
    display: flex;
    flex-direction: column;
  }

  .home-values-item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-md);
    align-items: start;
    padding-block: 1.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .home-values-item:first-child {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .item-number {
    font-family: var(--font-body);
    font-size: var(--fs-mono-md);
    letter-spacing: var(--ls-wide);
    font-variant-numeric: tabular-nums;
    opacity: 0.4;
    padding-top: 0.35rem;
  }

  .item-title {
    margin-bottom: 0.4rem;
    letter-spacing: var(--ls-tight);
  }

  .item-description {
    margin: 0;
    max-width: 48ch;
    font-family: var(--font-body);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>

---
/**
 * ServiceDetailBlock — repeating services chapter unit.
 */
import SectionShell from './SectionShell.astro'
import SectionHeading from './SectionHeading.astro'
import Button from './Button.astro'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  id: string
  icon: ImageMetadata
  iconAlt: string
  title: string
  tags: string[]
  ctaText: string
  ctaHref: string
  headline: string
  body: string
  /** Soft top rule for chapter separation (every other block) */
  withTopDivider?: boolean
}

const { id, icon, iconAlt, title, tags, ctaText, ctaHref, headline, body, withTopDivider = false } =
  Astro.props
---

<SectionShell
  sectionClass={`section-service-detail section-service-detail--${id}`}
  id={id}
  withTopDivider={withTopDivider}
>
  <div class="services-grid">
    <div class="services-grid-left">
      <div class="services-grid-left-inner">
        <div class="icon-wrap">
          <Image src={icon} alt={iconAlt} width={100} />
        </div>
        <SectionHeading as="h2" uppercase class="title">{title}</SectionHeading>
        {
          tags.length > 0 && (
            <ul class="service-list">
              {tags.map((tag) => (
                <li class="text-meta">{tag}</li>
              ))}
            </ul>
          )
        }
        <Button href={ctaHref} variant="primary">{ctaText}</Button>
      </div>
    </div>
    <div class="services-grid-right">
      <SectionHeading as="h3" variant="h1" class="headline">{headline}</SectionHeading>
      <p class="services-branding-text">{body}</p>
    </div>
  </div>
</SectionShell>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.38fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  @media screen and (max-width: 767px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  .icon-wrap {
    margin-bottom: 1rem;
  }

  .icon-wrap :global(img) {
    width: 3.25rem;
    height: auto;
    opacity: 0.9;
  }

  .title {
    margin-bottom: 1rem;
    letter-spacing: var(--ls-tight);
  }

  .service-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .text-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    line-height: var(--lh-relaxed);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .headline {
    margin-bottom: 1.25rem;
    max-width: 18ch;
    letter-spacing: var(--ls-display);
  }

  .services-branding-text {
    margin: 0;
    max-width: 62ch;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>

---
/**
 * ContactForm — FormSubmit AJAX → development@leviacore.com.
 * Keep endpoint, honeypot, and success/error regions intact.
 */
export interface Props {
  idPrefix?: string
}

const { idPrefix = 'contact' } = Astro.props

const formId = `${idPrefix}-form`
const nameId = `${idPrefix}-name`
const emailId = `${idPrefix}-email`
const messageId = `${idPrefix}-message`
---

<div class="form-wrapper" data-contact-form>
  <form
    id={formId}
    name={formId}
    class="form"
    action="https://formsubmit.co/ajax/development@leviacore.com"
    method="post"
  >
    <input type="hidden" name="_subject" value="Leviathan Core — website contact" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_captcha" value="false" />
    <input
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="form-honeypot"
    />
    <div class="form-field-wrapper">
      <label for={nameId} class="form-label">Name</label>
      <input
        class="form-input"
        maxlength="256"
        name="name"
        id={nameId}
        placeholder="Your Name"
        type="text"
        required
        aria-required="true"
      />
    </div>
    <div class="form-field-wrapper">
      <label for={emailId} class="form-label">Email</label>
      <input
        class="form-input"
        maxlength="256"
        name="email"
        id={emailId}
        placeholder="Your Email"
        type="email"
        required
        aria-required="true"
      />
    </div>
    <div class="form-field-wrapper">
      <label for={messageId} class="form-label">Message</label>
      <textarea
        id={messageId}
        name="message"
        maxlength="5000"
        placeholder="Your Message"
        class="form-input is-text-area"
        required
        aria-required="true"></textarea>
    </div>
    <button type="submit" class="button primary submit-button">Submit</button>
  </form>
  <div class="form-message-success" role="status" aria-live="polite" hidden>
    <p>Thank you! Your submission has been received!</p>
  </div>
  <div class="form-message-error" role="alert" aria-live="assertive" hidden>
    <p>Oops! Something went wrong while submitting the form.</p>
  </div>
</div>

<script>
  function wireContactForms() {
    document.querySelectorAll('[data-contact-form]').forEach((wrapper) => {
      const form = wrapper.querySelector('form')
      const success = wrapper.querySelector('.form-message-success')
      const error = wrapper.querySelector('.form-message-error')
      const submit = wrapper.querySelector('.submit-button')
      if (!(form instanceof HTMLFormElement) || !success || !error || !submit) return
      if (form.dataset.wired === '1') return
      form.dataset.wired = '1'

      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        success.hidden = true
        error.hidden = true

        const honey = form.querySelector('input[name="_gotcha"]')
        if (honey instanceof HTMLInputElement && honey.value.trim() !== '') {
          success.hidden = false
          form.hidden = true
          return
        }

        const previousLabel = submit.textContent
        submit.setAttribute('disabled', 'true')
        submit.textContent = 'Sending…'

        try {
          const body = new FormData(form)
          const response = await fetch(form.action, {
            method: 'POST',
            body,
            headers: { Accept: 'application/json' },
          })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const payload = await response.json().catch(() => ({}))
          if (payload.success === 'false' || payload.error) throw new Error(payload.message || 'submit failed')
          form.hidden = true
          success.hidden = false
        } catch {
          error.hidden = false
          submit.removeAttribute('disabled')
          submit.textContent = previousLabel || 'Submit'
        }
      })
    })
  }

  wireContactForms()
  document.addEventListener('astro:page-load', wireContactForms)
</script>

<style>
  .form-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-field-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    opacity: 0.65;
  }

  .form-input {
    width: 100%;
    box-sizing: border-box;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 35%, transparent);
    border-radius: 0;
    background: transparent;
    min-height: 3.25rem;
    padding: 0.65rem 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: var(--lh-loose);
    color: var(--color-ink);
    transition:
      border-color var(--duration-fast) var(--ease-editorial),
      background-color var(--duration-fast) var(--ease-editorial);
  }

  .form-input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  .form-input:focus-visible {
    outline: none;
    border-bottom-color: var(--color-ink);
    background: transparent;
    box-shadow: inset 0 -1px 0 var(--color-ink);
  }

  .form-input.is-text-area {
    min-height: 9rem;
    resize: vertical;
  }

  .submit-button {
    align-self: flex-start;
    margin-top: 0.35rem;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    padding: 0.9rem 1.5rem;
    min-inline-size: 14rem;
    cursor: pointer;
  }

  .submit-button:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .form-message-success,
  .form-message-error {
    padding: 0.25rem 0 0.25rem 1rem;
    font-family: var(--font-body);
    border-left: 2px solid var(--color-ink);
  }

  .form-message-error {
    background: transparent;
    border-left-color: #a33;
  }

  .form-message-success p,
  .form-message-error p {
    margin: 0;
  }

  .form-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
</style>

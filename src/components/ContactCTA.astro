---
/**
 * ContactCTA — closing contact chapter used on home, services, and /contact.
 */
import SectionHeading from './SectionHeading.astro'
import Eyebrow from './Eyebrow.astro'
import SocialBadge from './SocialBadge.astro'
import ContactForm from './ContactForm.astro'

interface SocialLink {
  platform: 'x' | 'linkedin'
  href: string
  label: string
}

interface Props {
  headingText?: string
  headingLevel?: 'h1' | 'h2'
  tagline: string
  socialLinks?: SocialLink[]
  withTopDivider?: boolean
  formIdPrefix?: string
}

const {
  headingText = "It's time to find your fandom.",
  headingLevel = 'h1',
  tagline,
  socialLinks,
  withTopDivider: _withTopDivider = false,
  formIdPrefix = 'cta-contact',
} = Astro.props
---

<section class="section-home-contact">
  <div class="contact-band">
    <div class="page-padding">
      <div class="container-xxlarge">
        <div class="contact-hero-grid">
          <div class="contact-hero-grid-left" data-reveal>
            <div class="heading-group">
              <Eyebrow class="eyebrow-spacing">Contact</Eyebrow>
              <SectionHeading as={headingLevel} variant="display-xl" class="cta-heading">{headingText}</SectionHeading>
            </div>
            <p class="tagline">{tagline}</p>
            {
              socialLinks && socialLinks.length > 0 && (
                <div class="social-row">
                  {socialLinks.map((social) => (
                    <SocialBadge platform={social.platform} href={social.href} label={social.label} />
                  ))}
                </div>
              )
            }
          </div>
          <div class="contact-hero-grid-right" data-reveal data-reveal-delay="100">
            <div class="form-shell">
              <ContactForm idPrefix={formIdPrefix} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-band {
    background: var(--color-ink-band);
    color: var(--color-on-ink);
    margin-inline: calc(-1 * var(--frame-padding));
    margin-bottom: calc(-1 * var(--space-sm));
    padding: var(--section-pad-y) var(--frame-padding) calc(var(--section-pad-y) + var(--space-sm));
    min-height: min(72vh, 720px);
    display: flex;
    align-items: center;
  }

  .contact-band > .page-padding {
    width: 100%;
  }

  .contact-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
  }

  @media screen and (max-width: 991px) {
    .contact-hero-grid {
      grid-template-columns: 1fr;
      align-items: stretch;
      gap: 2.5rem;
    }
  }

  .heading-group {
    margin-bottom: 1.25rem;
  }

  .cta-heading {
    white-space: pre-line;
    letter-spacing: var(--ls-display);
    max-width: 12ch;
  }

  .eyebrow-spacing {
    margin-bottom: 0.85rem;
    opacity: 0.65;
    color: var(--color-on-ink);
  }

  .tagline {
    margin: 0;
    max-width: 36ch;
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-on-ink) 78%, transparent);
  }

  .social-row {
    display: flex;
    gap: var(--space-xs);
    margin-top: 1.25rem;
  }

  .form-shell {
    max-width: none;
    padding: clamp(1.35rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--color-on-ink) 32%, transparent);
    background: color-mix(in srgb, var(--color-on-ink) 6%, transparent);
  }

  .form-shell :global(.form-label) {
    color: color-mix(in srgb, var(--color-on-ink) 78%, transparent);
    opacity: 1;
  }

  .form-shell :global(.form-input) {
    color: var(--color-on-ink);
    border-bottom-color: color-mix(in srgb, var(--color-on-ink) 48%, transparent);
  }

  .form-shell :global(.form-input::placeholder) {
    color: color-mix(in srgb, var(--color-on-ink) 55%, transparent);
  }

  .form-shell :global(.form-input:focus-visible) {
    border-bottom-color: var(--color-on-ink);
    background: color-mix(in srgb, var(--color-on-ink) 6%, transparent);
    outline: 2px solid var(--color-on-ink);
    outline-offset: 2px;
    box-shadow: none;
  }

  .form-shell :global(.submit-button) {
    background: var(--color-on-ink);
    color: var(--color-ink);
    border-color: var(--color-on-ink);
  }

  /* Paper submit on ink — use ink ring (high contrast on the light control) */
  .form-shell :global(.submit-button:focus-visible) {
    outline: 2px solid var(--color-on-ink);
    outline-offset: 3px;
  }

  .form-shell :global(.form-message-success),
  .form-shell :global(.form-message-error) {
    color: var(--color-on-ink);
    border-color: color-mix(in srgb, var(--color-on-ink) 40%, transparent);
  }

  .form-shell :global(.form-message-error) {
    background: color-mix(in srgb, #ffdede 20%, transparent);
  }
</style>

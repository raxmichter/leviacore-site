---
/**
 * ContactCTA — the "Contact" hero-style block (`section-home-contact`).
 *
 * Source: components.md #17. NOT the full contact.html page — this is the recurring block
 * that appears as index.html's final section, services.html's final section, AND as
 * contact.html's only section. Two columns: eyebrow + h1 + tagline + social row on the left,
 * `ContactForm` on the right.
 *
 * components.md §7 documents real divergence across the three instances that this component
 * must NOT silently unify:
 *   - contact.html omits the `.line` divider the other two have before the padded content
 *     (`withTopDivider={false}`).
 *   - Tagline copy differs (index/contact: "We can help. With PLANNING, NEGOTIATIONS,
 *     execution – the works." · services: "FOLLOW US on social for the latest.") — exposed as
 *     the `tagline` prop, not hardcoded.
 *   - Social hrefs differ per instance (index has a real Twitter link + placeholder `#`
 *     LinkedIn; services/contact use `#` for both, even though header/footer socials on the
 *     same pages are correctly linked) — exposed as the `socialLinks` prop so each page
 *     supplies its own source-accurate values rather than this component inventing one.
 *
 * The outer wrapper's `margin-bottom.margin-xxhuge` (around the eyebrow+heading group) hits
 * the tokens.md BLOCKER-2 trap: resolved to 1rem, frozen at every viewport, not the nominal
 * `--space-5xl` (12rem, responsive). Ported as literal `1rem`.
 *
 * C1a addition (index.astro): index.html's instance of this block uses a genuinely different
 * headline — "IT'S TIME TO FIND<br>YOUR FANDOM" (all-caps, source `<br>`-split) — vs. the
 * services/contact instances' "It's time to find your fandom." (sentence case, no break).
 * `headingText` already carried the copy difference; the line break needed a way in without
 * accepting raw markup through a string prop, so a literal `\n` in `headingText` now renders
 * as a line break (`white-space: pre-line` added below) — inert for every existing caller,
 * since none of them pass a newline.
 *
 * C1a addition: `headingLevel` (optional, defaults to `'h1'` — unchanged behavior for every
 * existing caller). index.astro's page `<h1>` is its hero headline, so this component's own
 * heading must render as `<h2>` there to keep exactly one `<h1>` per page; contact.html (where
 * this block is the page's only content) still wants it as the real `<h1>`.
 */
import SectionShell from './SectionShell.astro'
import SectionHeading from './SectionHeading.astro'
import Eyebrow from './Eyebrow.astro'
import SocialBadge from './SocialBadge.astro'
import ContactForm from './ContactForm.astro'

interface SocialLink {
  platform: 'twitter' | 'linkedin'
  href: string
  label: string
}

interface Props {
  headingText?: string
  headingLevel?: 'h1' | 'h2'
  tagline: string
  /** Optional. Omitted by every page as of 2026-08-11: the footer already renders
   * the same TW/IN pair directly below this block, so showing them here produced
   * two identical badge rows stacked on top of each other. George: keep the space
   * for the form, drop the duplicate. A deliberate difference from live. */
  socialLinks?: SocialLink[]
  withTopDivider?: boolean
  /** Forwarded to the embedded ContactForm so its ids stay unique. Only needs
   * overriding if a page renders this block AND a standalone ContactForm. */
  formIdPrefix?: string
}

const {
  headingText = "It's time to find your fandom.",
  headingLevel = 'h1',
  tagline,
  socialLinks,
  withTopDivider = true,
  formIdPrefix = 'cta-contact',
} = Astro.props
---

<SectionShell sectionClass="section-home-contact" withTopDivider={withTopDivider}>
  <div class="contact-hero-grid">
    <div class="contact-hero-grid-left">
      <div class="heading-group">
        <Eyebrow class="eyebrow-spacing">Contact</Eyebrow>
        <SectionHeading as={headingLevel} variant="display-xl" class="cta-heading">{headingText}</SectionHeading>
      </div>
      <div>
        <Eyebrow class="tagline">{tagline}</Eyebrow>
        {socialLinks && socialLinks.length > 0 && (
          <div class="social-row">
            {socialLinks.map((social) => (
              <SocialBadge platform={social.platform} href={social.href} label={social.label} />
            ))}
          </div>
        )}
      </div>
    </div>
    <div class="contact-hero-grid-right">
      <div class="form-shell">
        <ContactForm idPrefix={formIdPrefix} />
      </div>
    </div>
  </div>
</SectionShell>

<style>
  :global(.section-home-contact) {
    /* Extra air before the footer hairline so form + footer don't read as one block. */
    padding-bottom: var(--space-xl);
  }
  .contact-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }
  @media screen and (max-width: 991px) {
    .contact-hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .heading-group {
    margin-bottom: 1rem; /* frozen combo value — see file header */
  }
  .cta-heading {
    /* Allows a literal `\n` in `headingText` to render as a line break — see file header. */
    white-space: pre-line;
    letter-spacing: -0.03em;
  }
  .eyebrow-spacing {
    margin-bottom: var(--space-sm);
  }
  .tagline {
    margin-bottom: var(--space-sm);
  }
  .social-row {
    display: flex;
    gap: var(--space-xs);
  }
  .form-shell {
    max-width: var(--width-lg);
  }
</style>

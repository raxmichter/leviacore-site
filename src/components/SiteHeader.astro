---
/**
 * SiteHeader — sticky editorial masthead: logo, primary nav, CTA, socials, mobile menu.
 */
import { Image } from 'astro:assets'
import logo from '../assets/images/LC-SITE-NAV.png'
import MobileMenu from './MobileMenu.astro'
import Button from './Button.astro'
import { features } from '../config'

export interface Props {
  currentPath: string
}

const { currentPath } = Astro.props

const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/team', label: 'Team' },
  ...(features.blog ? [{ href: '/blog', label: 'Blog' }] : []),
]

const isCurrent = (path: string) => currentPath === path
---

<header class="header">
  <div class="navbar-wrapper">
    <div class="navbar">
      <div class="page-padding">
        <div class="container-xxlarge">
          <div class="navbar-inner">
            <div class="navbar-left">
              <a
                href="/"
                class="navbar-logo"
                aria-current={isCurrent('/') ? 'page' : undefined}
              >
                <Image src={logo} alt="Leviathan Core" width={250} class="navbar-logo-image" />
              </a>
            </div>
            <div class="navbar-right">
              <nav class="navbar-menu" aria-label="Primary">
                {
                  navLinks.map((link) => (
                    <a
                      href={link.href}
                      class="navbar-menu-item-link"
                      aria-current={isCurrent(link.href) ? 'page' : undefined}
                    >
                      {link.label}
                    </a>
                  ))
                }
              </nav>
              <div class="navbar-right-inner">
                <div class="navbar-right-button">
                  <Button href="/contact" ariaCurrent={isCurrent('/contact')}>
                    Let's make it happen
                  </Button>
                </div>
                <div class="navbar-right-social">
                  <a
                    href="https://twitter.com/leviacore"
                    class="badge small link"
                    aria-label="Leviathan Core on Twitter"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="text-meta-small" aria-hidden="true">Tw</span>
                  </a>
                  <a
                    href="https://www.linkedin.com/company/leviathan-core/"
                    class="badge small link"
                    aria-label="Leviathan Core on LinkedIn"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="text-meta-small" aria-hidden="true">IN</span>
                  </a>
                </div>
                <button
                  type="button"
                  id="mobile-menu-toggle"
                  class="mobile-menu-toggle"
                  aria-expanded="false"
                  aria-controls="mobile-menu"
                  aria-label="Open menu"
                >
                  <span class="mobile-menu-toggle-line"></span>
                  <span class="mobile-menu-toggle-line"></span>
                  <span class="mobile-menu-toggle-line"></span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <MobileMenu currentPath={currentPath} />
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle')
  const menu = document.getElementById('mobile-menu')

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open))
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
      toggle.classList.toggle('is-active', open)
      document.documentElement.classList.toggle('menu-open', open)
      if (open) {
        menu.removeAttribute('hidden')
      } else {
        menu.setAttribute('hidden', '')
      }
    }

    toggle.addEventListener('click', () => {
      setOpen(menu.hasAttribute('hidden'))
    })

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false)
        toggle.focus()
      }
    })

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false))
    })
  }
</script>

<style is:global>
  html.menu-open {
    overflow: hidden;
  }
</style>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  /* When the mobile drawer is open, solidify chrome so links read cleanly */
  :global(html.menu-open) .header {
    background: var(--color-bg);
    border-bottom-color: color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .navbar {
    position: relative;
    z-index: var(--z-navbar);
  }

  @media screen and (max-width: 767px) {
    .navbar {
      z-index: 10;
    }
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: 0.9rem 0.85rem;
  }

  .navbar-logo-image {
    display: block;
    height: auto;
    width: clamp(148px, 14vw, 210px);
  }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .navbar-menu {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .navbar-menu-item-link {
    position: relative;
    display: inline-block;
    padding: 0.4rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    opacity: 0.72;
    transition: opacity var(--duration-fast) var(--ease-editorial);
  }

  .navbar-menu-item-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.15rem;
    height: 1px;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-editorial);
  }

  .navbar-menu-item-link:hover,
  .navbar-menu-item-link[aria-current='page'] {
    opacity: 1;
  }

  .navbar-menu-item-link[aria-current='page']::after,
  .navbar-menu-item-link:hover::after {
    transform: scaleX(1);
  }

  @media screen and (max-width: 991px) {
    .navbar-menu {
      display: none;
    }
  }

  .navbar-right-inner {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .navbar-right-social {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    inline-size: var(--space-xl);
    block-size: var(--space-xl);
  }

  .mobile-menu-toggle-line {
    display: block;
    inline-size: var(--space-md);
    block-size: 1px;
    background: var(--color-ink);
    transform-origin: 50% 50%;
  }

  .mobile-menu-toggle-line:nth-child(1),
  .mobile-menu-toggle-line:nth-child(3) {
    transform: rotate(0deg);
    transition: transform 500ms cubic-bezier(0.165, 0.84, 0.44, 1) 0ms;
  }

  .mobile-menu-toggle-line:nth-child(2) {
    transform: scaleX(1);
    transition: transform 500ms cubic-bezier(0.165, 0.84, 0.44, 1) 300ms;
  }

  .mobile-menu-toggle.is-active .mobile-menu-toggle-line:nth-child(1) {
    transform: rotate(-39deg);
    transition-delay: 300ms;
  }

  .mobile-menu-toggle.is-active .mobile-menu-toggle-line:nth-child(3) {
    transform: rotate(39deg);
    transition-delay: 300ms;
  }

  .mobile-menu-toggle.is-active .mobile-menu-toggle-line:nth-child(2) {
    transform: scaleX(0);
    transition-delay: 0ms;
  }

  @media screen and (max-width: 991px) {
    .mobile-menu-toggle {
      display: flex;
    }
    .navbar-right-button,
    .navbar-right-social {
      display: none;
    }
    .navbar-logo-image {
      width: min(180px, 48vw);
    }
  }
</style>

---
/**
 * Button — primary filled / secondary outline CTAs with hover text-swap.
 */
interface Props {
  href?: string
  variant?: 'primary' | 'secondary' | 'inverse'
  type?: 'button' | 'submit'
  ariaCurrent?: boolean
  class?: string
}

const { href, variant = 'primary', type = 'button', ariaCurrent = false, class: className } = Astro.props

const classes = ['button', variant, className].filter(Boolean).join(' ')
---

{
  href ? (
    <a href={href} class={classes} aria-current={ariaCurrent ? 'page' : undefined}>
      <span class="button-inner">
        <span class="button-inner-text">
          <slot />
        </span>
        <span class="button-inner-text-hover" aria-hidden="true">
          <slot />
        </span>
      </span>
    </a>
  ) : (
    <button type={type} class={classes}>
      <span class="button-inner">
        <span class="button-inner-text">
          <slot />
        </span>
        <span class="button-inner-text-hover" aria-hidden="true">
          <slot />
        </span>
      </span>
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-transparent);
    color: var(--color-ink-button);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    padding: 0.85rem 1.35rem;
    margin: 0;
    transition:
      border-color var(--duration-fast) var(--ease-editorial),
      background-color var(--duration-fast) var(--ease-editorial);
  }

  .button.primary {
    background: var(--color-ink);
    color: var(--color-on-ink);
    border-color: var(--color-ink);
  }

  .button.inverse {
    background: var(--color-on-ink);
    color: var(--color-ink);
    border-color: var(--color-on-ink);
  }

  .button.secondary {
    border-color: color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  @media (hover: hover) {
    .button.secondary:hover {
      border-color: var(--color-ink);
      background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    }
  }

  .button:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* Inverse CTAs sit on ink bands — ink outline would vanish */
  .button.inverse:focus-visible {
    outline-color: var(--color-on-ink);
  }

  .button-inner {
    position: relative;
    display: inline-flex;
    overflow: hidden;
    min-height: 1.2em;
  }

  .button-inner-text-hover {
    position: absolute;
    inset: 100% 0 auto;
    pointer-events: none;
  }

  .button-inner-text,
  .button-inner-text-hover {
    transform: translateY(0);
    transition: transform 500ms var(--ease-editorial);
  }

  @media (hover: hover) and (min-width: 992px) {
    .button:hover .button-inner-text,
    .button:hover .button-inner-text-hover {
      transform: translateY(-100%);
    }
  }

  .button:focus-visible .button-inner-text,
  .button:focus-visible .button-inner-text-hover {
    transform: translateY(-100%);
  }
</style>

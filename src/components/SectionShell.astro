---
/**
 * SectionShell — universal outer wrapper for page sections.
 * Editorial redesign: more vertical air; top divider opt-in (default off)
 * so section rhythm comes from space and type, not hairline fatigue.
 */
interface Props {
  sectionClass: string
  padding?: 'large' | 'xlarge'
  withTopDivider?: boolean
  id?: string
  /** Tasteful scroll fade-up for section content. Default on. */
  reveal?: boolean
}

const { sectionClass, padding = 'xlarge', withTopDivider = false, id, reveal = true } = Astro.props
---

<section class={sectionClass} id={id}>
  <div class="page-padding">
    <div class="container-xxlarge">
      {withTopDivider && <div class="line" aria-hidden="true"></div>}
      <div class={`padding-vertical padding-${padding}`} data-reveal={reveal || undefined}>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .padding-vertical.padding-large {
    padding-block: var(--section-pad-y-sm);
  }

  .padding-vertical.padding-xlarge {
    padding-block: var(--section-pad-y);
  }

  .padding-vertical.padding-xhuge {
    padding-block: clamp(4rem, 9vw, 7rem);
  }
</style>

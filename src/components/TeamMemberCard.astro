---
/**
 * TeamMemberCard — portrait + name + role.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import SectionHeading from './SectionHeading.astro'
import Eyebrow from './Eyebrow.astro'

interface Props {
  name: string
  role: string
  image: ImageMetadata
  alt: string
  hiring?: boolean
  headingLevel?: 'h2' | 'h3' | 'h4'
}

const { name, role, image, alt, hiring = false, headingLevel = 'h3' } = Astro.props
---

<article class:list={['team-member-card', { 'is-hiring': hiring }]} data-reveal>
  <div class="studio-team-image-wrapper">
    <Image src={image} alt={alt} class="image-cover" />
  </div>
  <SectionHeading as={headingLevel} variant="h4" class="name">{name}</SectionHeading>
  <Eyebrow class="role">{role}</Eyebrow>
</article>

<style>
  .team-member-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .studio-team-image-wrapper {
    margin-bottom: 0.35rem;
    overflow: hidden;
    height: min(22vw, 340px);
    background: var(--color-paper-deep);
  }

  @media screen and (max-width: 991px) {
    .studio-team-image-wrapper {
      height: auto;
      aspect-ratio: 4 / 5;
      width: 100%;
    }
  }

  .studio-team-image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms var(--ease-editorial);
  }

  @media (hover: hover) and (min-width: 992px) {
    .team-member-card:hover .studio-team-image-wrapper :global(img) {
      transform: scale(1.03);
    }
  }

  .name {
    margin: 0;
    color: var(--color-ink);
    letter-spacing: var(--ls-tight);
  }

  .role {
    color: var(--color-ink);
    opacity: 0.55;
    max-width: none;
  }

  .is-hiring .studio-team-image-wrapper {
    background: color-mix(in srgb, var(--color-ink) 6%, var(--color-bg));
  }

  .is-hiring .name {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>

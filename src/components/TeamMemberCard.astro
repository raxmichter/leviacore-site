---
/**
 * TeamMemberCard — team.html roster card: photo + name + role, nothing else.
 *
 * Source: components.md #20 and §5. Markup: `.studio-team-image-wrapper > img.image-cover` +
 * `h3.heading-h4` (name) + `div.text-meta` (role). No bio, no social links, no CTA.
 *
 * The "We're Hiring!" placeholder (§5) is confirmed structurally IDENTICAL to a real member
 * card in the source — same DOM shape, different content, no interactive affordance despite
 * being a job posting. Modeled here as `hiring` boolean on this one component rather than a
 * separate component, per the build brief and per components.md's explicit note that the
 * brief expected a structural difference that doesn't exist in the markup.
 *
 * `alt` is a required prop, not optional. Every headshot in the source export ships
 * `alt=""` — an accessibility gap this migration is explicitly meant to close (see the B2
 * brief). There is no safe default to fall back to, so omitting it is a type error.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import SectionHeading from './SectionHeading.astro'
import Eyebrow from './Eyebrow.astro'

interface Props {
  name: string
  role: string
  image: ImageMetadata
  alt: string
  hiring?: boolean
  headingLevel?: 'h2' | 'h3' | 'h4'
}

const { name, role, image, alt, hiring = false, headingLevel = 'h3' } = Astro.props
---

<article class:list={['team-member-card', { 'is-hiring': hiring }]}>
  <div class="studio-team-image-wrapper">
    <Image src={image} alt={alt} class="image-cover" />
  </div>
  <SectionHeading as={headingLevel} variant="h4" class="name">{name}</SectionHeading>
  <Eyebrow class="role">{role}</Eyebrow>
</article>

<style>
  .team-member-card {
    display: flex;
    flex-direction: column;
  }
  .studio-team-image-wrapper {
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-card);
    overflow: hidden;
    /* tokens.md §5f: height 18vw, max-height 300px base → 25vw @<=991 → 50vw @<=767 */
    height: 18vw;
    max-height: 300px;
  }
  @media screen and (max-width: 991px) {
    .studio-team-image-wrapper {
      height: 25vw;
    }
  }
  @media screen and (max-width: 767px) {
    .studio-team-image-wrapper {
      /* 50vw was ~187px at 375; live full-width photos are ~520px (430/290). */
      height: auto;
      max-height: none;
      aspect-ratio: 430 / 290;
      width: 100%;
    }
  }
  .studio-team-image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .name {
    margin-bottom: var(--space-xxs);
    color: var(--color-ink);
  }
  .role {
    color: var(--color-ink);
  }
</style>

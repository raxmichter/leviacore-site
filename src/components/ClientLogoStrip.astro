---
/**
 * ClientLogoStrip — "brands we've helped" proof row.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Eyebrow from './Eyebrow.astro'

interface Logo {
  src: ImageMetadata
  alt: string
}

interface Props {
  logos: Logo[]
}

const { logos } = Astro.props
---

<div class="home-clients-grid">
  <Eyebrow>brands we&#x27;ve helped</Eyebrow>
  <ul class="home-clients-logos">
    {
      logos.map((logo) => (
        <li>
          <Image src={logo.src} alt={logo.alt} class="client-logo" />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .home-clients-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.35rem;
  }

  .home-clients-logos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.25rem) clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding: 1.25rem 0 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  @media screen and (max-width: 991px) {
    .home-clients-logos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .home-clients-logos :global(.client-logo) {
    width: 100%;
    height: auto;
    max-height: 2rem;
    object-fit: contain;
    opacity: 0.7;
    filter: grayscale(1);
    transition: opacity var(--duration-fast) var(--ease-editorial);
  }

  @media (hover: hover) {
    .home-clients-logos li:hover :global(.client-logo) {
      opacity: 1;
    }
  }
</style>

---
/**
 * BaseLayout — the one shell every page renders through.
 *
 * Emits <head> metadata (title, description, OG/Twitter, canonical, icons,
 * font preloads, GA4) and wraps page content with SiteHeader above and
 * SiteFooter below. Pages own everything inside <slot />.
 */
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'

export interface Props {
  title: string
  description: string
  /** Absolute URL to a social-preview image. Defaults to the site's own
   * /og-image.png — localized in Phase D2; see the note below. */
  ogImage?: string
  /** Path used for both the canonical <link> and nav "current page" state,
   * e.g. "/", "/services", "/team". No trailing slash except "/" itself,
   * matching astro.config.mjs's trailingSlash: 'never'. */
  canonicalPath: string
  /** Emit <meta name="robots" content="noindex,nofollow"> and drop the
   * canonical link. For pages that must never be indexed — the dev component
   * gallery today; Phase F may also want it for utility routes. Must live in
   * <head> to be honoured, which is why this is a prop and not something a
   * page can inject from its own body. */
  noindex?: boolean
}

const { title, description, ogImage, canonicalPath, noindex = false } = Astro.props

/**
 * Social preview card. Localized in Phase D2.
 *
 * The export pointed og:image and twitter:image at https://i.imgur.com/dYUCEcI.png —
 * the site's primary social preview hosted on a third-party image host nobody here
 * controls. If that link ever rotted, every share of every page would lose its
 * preview image silently. The identical asset (1200×630 branded card) now ships
 * from this repo.
 *
 * Absolute URL is required: og:image must be fully qualified, since crawlers and
 * chat clients fetch it out of page context.
 */
const DEFAULT_OG_IMAGE = '/og-image.png'
const canonicalUrl = new URL(canonicalPath, Astro.site)
const resolvedOgImage = new URL(ogImage ?? DEFAULT_OG_IMAGE, Astro.site).href

/**
 * JSON-LD Organization schema — Phase F.
 *
 * The live site has no structured data at all. This is free search-result
 * enhancement that was simply never added.
 *
 * Emitted on the homepage only. Repeating an Organization block on every page
 * adds no signal and risks search engines treating the site as declaring many
 * organisations rather than one.
 *
 * Every value below is taken from the site's own content — the footer tagline
 * ("...in the gaming space since 2017"), the header social links, and the
 * homepage meta description. Nothing here is invented.
 */
const isHomepage = canonicalPath === '/'
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).href,
  name: 'Leviathan Core',
  legalName: 'Leviathan Core, LLC',
  url: new URL('/', Astro.site).href,
  logo: new URL('/og-image.png', Astro.site).href,
  description:
    "Influencer marketing for the gaming industry. Partnering with the right influencers and connecting with the right audiences.",
  foundingDate: '2017',
  sameAs: [
    'https://twitter.com/leviacore',
    'https://www.linkedin.com/company/leviathan-core/',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'development@leviacore.com',
    url: new URL('/contact', Astro.site).href,
  },
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex,nofollow" />
      ) : (
        <link rel="canonical" href={canonicalUrl} />
      )
    }

    {
      /* JSON-LD Organization — homepage only. Absent from the live site entirely. */
      isHomepage && !noindex && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(organizationSchema)}
        />
      )
    }

    <!-- Open Graph + Twitter card — shape ported verbatim from the export's
         homepage <head> (_webflow-export/index.html). -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/webclip.png" />

    <link
      rel="preload"
      href="/fonts/syne-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Satoshi-Regular.woff"
      as="font"
      type="font/woff"
      crossorigin
    />

    <!-- GA4 — verbatim from every page of the live export. Must survive migration. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EG4F7ZLTZQ"></script>
    <script>
      import '../scripts/ga'
    </script>
  </head>
  <body>
    <SiteHeader currentPath={canonicalPath} />
    <main class="main-wrapper">
      <slot />
    </main>
    <SiteFooter currentPath={canonicalPath} />

    {/* Phase E — scroll reveals (a-174/175/176) and image parallax (a-139). Loaded here
        rather than per page because `.line` / `.line-vertical` are header and footer chrome
        and the source bound them on all 15 chrome-bearing pages. The custom cursor is NOT
        loaded here — it shipped on five pages only and is wired per page. */}
    <script>
      import '../scripts/interactions'
    </script>
  </body>
</html>

<style>
  .main-wrapper {
    border-radius: 0;
    /* Do NOT set overflow: clip/hidden here — it kills position:sticky descendants
       (homepage services intro, team intro). Radius alone is enough for the shell. */
  }

  @media screen and (max-width: 991px) {
    .main-wrapper {
      border-radius: var(--radius-shell);
    }
  }
</style>

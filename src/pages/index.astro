---
/**
 * Homepage (`/`) — Phase C1a.
 *
 * Port of _webflow-export/index.html. Section order per build-context/components.md §2:
 * hero → client logos → services summary → featured projects teaser → how we work → values
 * → contact. SiteHeader/SiteFooter come from BaseLayout.
 *
 * Copy is ported verbatim except the <title>, which the build brief explicitly calls out as
 * a defect: the export ships only "Leviathan Core" (weakest SEO on the highest-value page)
 * while interior pages correctly use "X | Leviathan Core". Fixed here, nowhere else.
 *
 * Heading hierarchy: this page's one <h1> is the hero headline below. ContactCTA normally
 * renders its own heading as <h1> (it's the sole heading on contact.html), so here it's
 * called with `headingLevel="h2"` — an additive prop added to ContactCTA.astro this phase,
 * see that file's header for the full note.
 */
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Cursor from '../components/Cursor.astro'
import SectionShell from '../components/SectionShell.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Eyebrow from '../components/Eyebrow.astro'
import Divider from '../components/Divider.astro'
import Button from '../components/Button.astro'
import ClientLogoStrip from '../components/ClientLogoStrip.astro'
import ValuesList from '../components/ValuesList.astro'
import ContactCTA from '../components/ContactCTA.astro'

import heroImage from '../assets/images/LC-Team-Final.jpg'
import amazonGames from '../assets/images/amazon_games.png'
import bungie from '../assets/images/bungie.png'
import thunderLotus from '../assets/images/thunder_lotus.png'
import digitalExtremes from '../assets/images/digital_extremes.png'
import grindingGear from '../assets/images/grinding_gear.png'
import northBeach from '../assets/images/north_beach.png'
import twoK from '../assets/images/2K_2021_Logo.png'
import privateDivision from '../assets/images/private_division.png'
import icon01 from '../assets/images/icon-01.svg'
import icon02 from '../assets/images/icon-02.svg'
import icon03 from '../assets/images/icon-03.svg'
import icon04 from '../assets/images/icon-04.svg'

const clientLogos = [
  { src: amazonGames, alt: 'Amazon Games' },
  { src: bungie, alt: 'Bungie' },
  { src: thunderLotus, alt: 'Thunder Lotus Games' },
  { src: digitalExtremes, alt: 'Digital Extremes' },
  { src: grindingGear, alt: 'Grinding Gear Games' },
  { src: northBeach, alt: 'North Beach Games' },
  { src: twoK, alt: '2K' },
  { src: privateDivision, alt: 'Private Division' },
]

// Copy/casing/order ported verbatim from index.html's `.home-services-item` blocks. The
// mixed casing ("Consulting" vs "campaigns"/"legal"/"finance") is the source's own
// inconsistency, preserved per the "don't improve copy" rule — CSS uppercases all four
// visually regardless.
const services = [
  {
    icon: icon01,
    alt: 'Consulting service icon',
    title: 'Consulting',
    description:
      'Guidance for everything from influencer marketing trends to creator programs and strategies.',
  },
  {
    icon: icon02,
    alt: 'Campaigns service icon',
    title: 'campaigns',
    description:
      'From coordinating logistics to facilitating paid collaborations, we help shape influencer campaigns for impact.',
  },
  {
    icon: icon03,
    alt: 'Legal service icon',
    title: 'legal',
    description: 'The legal landscape of influencer marketing is constantly changing. We help brands navigate it.',
  },
  {
    icon: icon04,
    alt: 'Finance service icon',
    title: 'finance',
    description:
      'Coordinating finances and payments to influencers, protecting brand reputations in the process.',
  },
]
const serviceRows = [services.slice(0, 2), services.slice(2, 4)]

const valuesItems = [
  {
    number: '01',
    title: 'AUTHENTICITY',
    description:
      "This crew loves what we do. It helps us push harder, and we love working with brands and communities that feel the same way.",
  },
  {
    number: '02',
    title: 'TRANSPARENCY',
    description:
      "Blame it on our Midwestern roots, but we believe in the power of integrity. We'll always give it to you straight, and never keep you in the dark.",
  },
  {
    number: '03',
    title: 'ADAPTIVITY',
    description:
      "Stop innovating in the gaming realm and you'll become irrelevant. We'd rather be irreplaceable by adapting to every challenge that comes our way.",
  },
  {
    number: '04',
    title: 'TEAMWORK',
    description:
      "Building games is a team sport. So is building fanbases. Collaboration isn't just smart, it makes the process more fun and enjoyable for everyone.",
  },
]

/**
 * Featured projects teaser — Phase D1. Source: components.md §6 "index.html —
 * FeaturedProjectsTeaser". The export shows two side-by-side CMS-bound lists (likely one
 * featured item + a grid of the rest), but both are empty and components.md explicitly flags
 * that the count-per-list split can't be confirmed without Webflow dashboard access — deferred
 * to the CSV, which hasn't arrived.
 *
 * Rather than invent a split that can't be verified, this renders ONE simple list from the
 * same `projects` collection `/projects` itself uses (order asc, year desc), capped at 3 —
 * a plain, defensible "teaser" size for a homepage section whose own copy already says "just a
 * few of our favorites," and small enough that it reads as a teaser rather than a duplicate of
 * the full `/projects` grid. No placeholder cards are rendered for an empty collection (same
 * rule as `/projects`); today this is empty in production since only the draft fixture exists.
 */
const isProd = import.meta.env.PROD
const featuredProjectEntries = await getCollection('projects', (entry) => !isProd || !entry.data.draft)
const featuredProjects = featuredProjectEntries
  .sort((a, b) => {
    const orderA = a.data.order ?? Number.POSITIVE_INFINITY
    const orderB = b.data.order ?? Number.POSITIVE_INFINITY
    if (orderA !== orderB) return orderA - orderB
    return b.data.year - a.data.year
  })
  .slice(0, 3)
  .map((entry) => ({
    title: entry.data.title,
    client: entry.data.client,
    image: entry.data.heroImage,
    imageAlt: entry.data.heroImageAlt,
    href: `/project/${entry.id}`,
  }))

// NOTE: the ContactCTA social row is intentionally NOT rendered. The footer already
// shows the same TW/IN pair immediately below that block, so rendering it there produced
// two identical badge rows stacked together. Removed 2026-08-11 per George — a deliberate
// difference from live, which does show both.
---

<BaseLayout
  title="Influencer Marketing Agency for Gaming Brands | Leviathan Core"
  description="You can't buy hype, but you can earn it. Partnering with the right influencers and connecting with the right audiences is how it's done. We help brands build hype with both."
  canonicalPath="/"
>
  {/* Phase E — custom cursor (a-8 / a-165 / a-166). Five pages only; see Cursor.astro. */}
  <Cursor />

  <SectionShell sectionClass="section-home-hero" withTopDivider={false} reveal={false}>
    <div class="home-hero-grid">
      <div class="home-hero-grid-left" data-reveal data-reveal-delay="0">
        <Eyebrow class="hero-eyebrow">Gaming influencer marketing</Eyebrow>
        <SectionHeading as="h1" variant="display-2xl" class="hero-heading">
          You can't buy hype,<br />but you can earn it.
        </SectionHeading>
        <p class="lead-text hero-intro">
          Partnering with the right influencers and connecting with the right audiences is how it's done. We help
          brands build hype with both.
        </p>
        <Button href="/contact" class="hero-cta">Let's make it happen</Button>
      </div>
      <div class="home-hero-image-wrapper" data-reveal data-reveal-delay="120">
        <Image src={heroImage} alt="The Leviathan Core team" class="image-cover" />
      </div>
    </div>
  </SectionShell>

  <SectionShell sectionClass="section-home-clients">
    <ClientLogoStrip logos={clientLogos} />
  </SectionShell>

  <SectionShell sectionClass="section-home-services" reveal={false}>
    <div class="home-services-grid">
      <div class="home-services-intro" data-reveal>
        <SectionHeading as="h2" variant="display-lg" uppercase class="services-heading">Services that stand out</SectionHeading>
        <p class="lead-text lead-text--md">
          Hands-on guidance and innovative, end-to-end solutions tailor-made for the gaming industry. It's
          influencer marketing with next-level professionalism.
        </p>
      </div>
      <!-- Source only marks the divider `hide-mobile-landscape` here (unlike ClientLogoStrip's
           grid, there is no paired `show-mobile-landscape` swap element) — ported as a single
           divider that disappears at <=767 rather than inventing a horizontal replacement. -->
      <Divider orientation="vertical" responsive="hide-mobile-landscape" />
      <div class="home-services-grid-right" data-reveal data-reveal-delay="100">
        {
          serviceRows.map((row, rowIndex) => (
            <>
              {rowIndex > 0 && <Divider />}
              <div class="home-services-grid-right-row">
                {row.map((item, itemIndex) => (
                  <>
                    {itemIndex > 0 && (
                      <>
                        <Divider orientation="vertical" responsive="hide-tablet" />
                        <Divider orientation="horizontal" responsive="show-tablet" />
                      </>
                    )}
                    <div class="home-services-item">
                      <Image src={item.icon} alt={item.alt} class="service-icon" />
                      <div>
                        <SectionHeading as="h3" uppercase class="service-item-title">
                          {item.title}
                        </SectionHeading>
                        <p class="service-item-description">{item.description}</p>
                      </div>
                    </div>
                  </>
                ))}
              </div>
            </>
          ))
        }
      </div>
    </div>
  </SectionShell>

  {/*
    Featured projects. Intro | divider | equal card grid (3-up desktop, 1-up ≤991).
    Deliberate departure from live Webflow's "hero lead + two-up" — the oversized
    lead card read as broken next to the smaller pair (critique / Max 2026-08-12).

    ⚠️ NO YEAR. The live cards print the campaign year to the right of each title;
    George asked for it to be left off. `year` remains in the schema and still
    drives sort order — it is simply not displayed here.
  */}
  <SectionShell sectionClass="section-home-projects" reveal={false}>
    <div class="home-projects-grid">
      <div class="home-projects-grid-left-inner" data-reveal>
        <SectionHeading as="h2" variant="display-lg" uppercase class="projects-heading">Featured projects</SectionHeading>
        <p class="lead-text lead-text--md">
          See how our innovative, hands-on approach has helped brands like yours grow fanbases, generate buzz, and
          break records.
        </p>
        <Button href="/projects" variant="secondary">See more</Button>
      </div>
      <div class="line-vertical hide-mobile-landscape" aria-hidden="true"></div>
      {
        featuredProjects.length > 0 && (
          <ul class="home-projects-grid-right">
            {featuredProjects.map((project, projectIndex) => (
              <li
                class="home-project-preview-item"
                data-reveal
                data-reveal-delay={String(projectIndex * 90)}
              >
                <a href={project.href} class="home-project-preview-image-wrapper">
                  <Image src={project.image} alt={project.imageAlt} class="image-cover" />
                </a>
                <div class="home-project-preview-content">
                  <a href={project.href} class="home-project-preview-title-link">
                    <SectionHeading as="h3" variant="h3" uppercase>
                      {project.title}
                    </SectionHeading>
                  </a>
                  <p class="home-project-preview-meta">{project.client}</p>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </SectionShell>

  <SectionShell sectionClass="section-home-how">
    <Eyebrow class="how-eyebrow">How we work</Eyebrow>
    <SectionHeading as="h2" variant="display-xl" class="how-heading">
      PEOPLE SHARE WHAT THEY LOVE. GAMERS AREN'T ANY DIFFERENT.
    </SectionHeading>
    <p class="lead-text how-copy">
      Gamers aren't dumb. They know when they're being played, and when their favorite streamers are being paid to
      fake fandom. It shows. We use our deep community roots to connect brands with influencers who will actually
      appreciate them – and share those brands with their friends.
    </p>
  </SectionShell>

  <ValuesList items={valuesItems} portraitAlt="Portrait photo representing the Leviathan Core team" />

  <ContactCTA
    headingText={"IT'S TIME TO FIND\nYOUR FANDOM"}
    headingLevel="h2"
    tagline="We can help. With PLANNING, NEGOTIATIONS, execution – the works."
  />
</BaseLayout>

<style>
  .lead-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    line-height: var(--lh-loose);
  }
  .lead-text--md {
    font-size: var(--fs-lg);
    line-height: var(--lh-looser);
  }

  /* ---------- Hero ---------- */
  /* Source `.home-hero-grid` (leviathan-core-2023-r1.webflow.css:3027):
       base    grid-template-columns: 1fr .75fr;  gap: 3rem
       ≥1440   gap: 6rem
       ≤991    grid-template-columns: 1fr;        gap: 3rem

     Three corrections here, only one of which the breakpoint audit flagged:
       - columns were 1fr 1fr, so the hero image column was too wide
       - gap was --space-xl (4rem), source is 3rem
       - the ≥1440 doubling to 6rem was missing entirely

     Gap is a literal 3rem rather than --space-lg because source restates 3rem
     inside the ≤991 block, whereas --space-lg steps down to 2.5rem there. Using
     the token would quietly shrink the gap on tablet. */
  .home-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
  }
  @media screen and (min-width: 1440px) {
    .home-hero-grid {
      gap: 6rem;
    }
  }
  @media screen and (max-width: 991px) {
    .home-hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
  :global(.hero-eyebrow) {
    margin-bottom: 0;
  }
  :global(a.hero-cta.button) {
    align-self: flex-start;
    margin-top: var(--space-sm);
    padding-inline: var(--space-md);
    padding-block: 0.85rem;
  }
  .home-hero-grid-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .hero-heading {
    max-width: none;
    letter-spacing: -0.02em;
  }
  .hero-intro {
    max-width: var(--width-lg);
    font-size: var(--fs-xl);
  }
  .home-hero-image-wrapper {
    border-radius: var(--radius-card);
    overflow: hidden;
    outline: 3px solid var(--color-ink);
    outline-offset: 0;
  }
  .home-hero-image-wrapper :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  /* ---------- Services summary ---------- */
  .home-services-grid {
    display: grid;
    grid-template-columns: auto var(--divider-width) 1fr;
    gap: var(--space-lg);
    align-items: center;
  }
  @media screen and (max-width: 767px) {
    .home-services-grid {
      grid-template-columns: 1fr;
      /* Vertical divider is display:none with no horizontal swap — do not reserve
         a 1px middle track or the services column collapses and overlaps below. */
    }
  }
  .home-services-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 20rem;
  }
  .services-heading {
    letter-spacing: -0.02em;
  }
  .home-services-grid-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .home-services-grid-right-row {
    display: grid;
    grid-template-columns: 1fr var(--divider-width) 1fr;
    gap: var(--space-md);
    align-items: start;
  }
  @media screen and (max-width: 767px) {
    .home-services-grid-right-row {
      grid-template-columns: 1fr;
      grid-template-rows: auto var(--divider-width) auto;
    }
  }
  .home-services-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .home-services-item :global(.service-icon) {
    width: 3.25rem;
    height: 3.25rem;
  }
  .service-item-title {
    margin-bottom: var(--space-xs);
  }
  .service-item-description {
    margin: 0;
    font-family: var(--font-body);
  }

  /* ---------- Featured projects teaser ---------- */
  /* Source `.home-projects-grid` css:3151 — intro | 1px divider | cards.
     `.home-projects-grid-right` (css:3144) is a flex column, row-gap 2rem. */
  .home-projects-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: stretch;
  }

  .home-projects-grid > .line-vertical {
    display: none;
  }

  .home-projects-grid-left-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .home-projects-grid-right {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 768px) {
    .home-projects-grid-right {
      grid-template-columns: 1fr 1fr 1fr;
      gap: var(--space-lg);
    }
  }
  .projects-heading {
    max-width: 18rem;
    letter-spacing: -0.02em;
  }
  .home-projects-intro .lead-text {
    max-width: var(--width-sm);
  }
  /* (The previous uniform auto-fit `.home-projects-grid` rule lived here; it is
     replaced by the source's intro | divider | cards grid defined above.) */
  .home-project-preview-item {
    display: flex;
    flex-direction: column;
  }
  .home-project-preview-image-wrapper {
    display: block;
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-card);
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  .home-project-preview-image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (hover: hover) and (min-width: 992px) {
    .home-project-preview-item:hover .home-project-preview-image-wrapper :global(img) {
      transform: scale(1.04);
    }
  }
  .home-project-preview-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xxs);
  }
  .home-project-preview-title-link {
    color: inherit;
    text-decoration: none;
  }
  .home-project-preview-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-ink);
  }

  /* ---------- How we work ---------- */
  :global(.how-eyebrow) {
    margin-bottom: var(--space-xs);
  }
  :global(.how-heading) {
    max-width: var(--width-2xl);
    margin-bottom: var(--space-md);
  }
  .how-copy {
    max-width: none;
  }
</style>

---
/**
 * Homepage (`/`) — editorial agency redesign.
 * Copy reused from the existing site; composition and chrome rebuilt.
 */
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Cursor from '../components/Cursor.astro'
import SectionShell from '../components/SectionShell.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Eyebrow from '../components/Eyebrow.astro'
import Button from '../components/Button.astro'
import ClientLogoStrip from '../components/ClientLogoStrip.astro'
import ValuesList from '../components/ValuesList.astro'
import ContactCTA from '../components/ContactCTA.astro'

import heroImage from '../assets/images/LC-Team-Final.jpg'
import amazonGames from '../assets/images/amazon_games.png'
import bungie from '../assets/images/bungie.png'
import thunderLotus from '../assets/images/thunder_lotus.png'
import digitalExtremes from '../assets/images/digital_extremes.png'
import grindingGear from '../assets/images/grinding_gear.png'
import northBeach from '../assets/images/north_beach.png'
import twoK from '../assets/images/2K_2021_Logo.png'
import privateDivision from '../assets/images/private_division.png'
import icon01 from '../assets/images/icon-01.svg'
import icon02 from '../assets/images/icon-02.svg'
import icon03 from '../assets/images/icon-03.svg'
import icon04 from '../assets/images/icon-04.svg'

const clientLogos = [
  { src: amazonGames, alt: 'Amazon Games' },
  { src: bungie, alt: 'Bungie' },
  { src: thunderLotus, alt: 'Thunder Lotus Games' },
  { src: digitalExtremes, alt: 'Digital Extremes' },
  { src: grindingGear, alt: 'Grinding Gear Games' },
  { src: northBeach, alt: 'North Beach Games' },
  { src: twoK, alt: '2K' },
  { src: privateDivision, alt: 'Private Division' },
]

const services = [
  {
    icon: icon01,
    alt: 'Consulting service icon',
    title: 'Consulting',
    description:
      'Guidance for everything from influencer marketing trends to creator programs and strategies.',
  },
  {
    icon: icon02,
    alt: 'Campaigns service icon',
    title: 'campaigns',
    description:
      'From coordinating logistics to facilitating paid collaborations, we help shape influencer campaigns for impact.',
  },
  {
    icon: icon03,
    alt: 'Legal service icon',
    title: 'legal',
    description: 'The legal landscape of influencer marketing is constantly changing. We help brands navigate it.',
  },
  {
    icon: icon04,
    alt: 'Finance service icon',
    title: 'finance',
    description:
      'Coordinating finances and payments to influencers, protecting brand reputations in the process.',
  },
]

const valuesItems = [
  {
    number: '01',
    title: 'AUTHENTICITY',
    description:
      "This crew loves what we do. It helps us push harder, and we love working with brands and communities that feel the same way.",
  },
  {
    number: '02',
    title: 'TRANSPARENCY',
    description:
      "Blame it on our Midwestern roots, but we believe in the power of integrity. We'll always give it to you straight, and never keep you in the dark.",
  },
  {
    number: '03',
    title: 'ADAPTIVITY',
    description:
      "Stop innovating in the gaming realm and you'll become irrelevant. We'd rather be irreplaceable by adapting to every challenge that comes our way.",
  },
  {
    number: '04',
    title: 'TEAMWORK',
    description:
      "Building games is a team sport. So is building fanbases. Collaboration isn't just smart, it makes the process more fun and enjoyable for everyone.",
  },
]

const isProd = import.meta.env.PROD
const featuredProjectEntries = await getCollection('projects', (entry) => !isProd || !entry.data.draft)
const featuredProjects = featuredProjectEntries
  .sort((a, b) => {
    const orderA = a.data.order ?? Number.POSITIVE_INFINITY
    const orderB = b.data.order ?? Number.POSITIVE_INFINITY
    if (orderA !== orderB) return orderA - orderB
    return b.data.year - a.data.year
  })
  .slice(0, 3)
  .map((entry) => ({
    title: entry.data.title,
    client: entry.data.client,
    image: entry.data.heroImage,
    imageAlt: entry.data.heroImageAlt,
    href: `/project/${entry.id}`,
  }))
---

<BaseLayout
  title="Influencer Marketing Agency for Gaming Brands | Leviathan Core"
  description="You can't buy hype, but you can earn it. Partnering with the right influencers and connecting with the right audiences is how it's done. We help brands build hype with both."
  canonicalPath="/"
>
  <Cursor />

  <section class="section-home-hero">
    <div class="home-hero-plane">
      <div class="home-hero-media" data-reveal data-reveal-delay="80">
        <Image src={heroImage} alt="The Leviathan Core team" class="image-cover" />
      </div>
      <div class="page-padding home-hero-copy-wrap">
        <div class="container-xxlarge">
          <div class="home-hero-copy" data-reveal>
            <p class="brand-mark">Leviathan Core</p>
            <Eyebrow class="hero-eyebrow">Gaming influencer marketing</Eyebrow>
            <SectionHeading as="h1" variant="display-2xl" class="hero-heading">
              You can't buy hype,<br />but you can earn it.
            </SectionHeading>
            <p class="lead-text hero-intro">
              Partnering with the right influencers and connecting with the right audiences is how it's done. We help
              brands build hype with both.
            </p>
            <Button href="/contact" class="hero-cta">Let's make it happen</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionShell sectionClass="section-home-clients">
    <ClientLogoStrip logos={clientLogos} />
  </SectionShell>

  <SectionShell sectionClass="section-home-services" reveal={false}>
    <div class="home-services-grid">
      <div class="home-services-intro" data-reveal>
        <SectionHeading as="h2" variant="display-lg" uppercase class="services-heading">Services that stand out</SectionHeading>
        <p class="lead-text lead-text--md">
          Hands-on guidance and innovative, end-to-end solutions tailor-made for the gaming industry. It's
          influencer marketing with next-level professionalism.
        </p>
      </div>
      <div class="home-services-list" data-reveal data-reveal-delay="100">
        {
          services.map((item) => (
            <div class="home-services-item">
              <Image src={item.icon} alt={item.alt} class="service-icon" />
              <div>
                <SectionHeading as="h3" uppercase class="service-item-title">
                  {item.title}
                </SectionHeading>
                <p class="service-item-description">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </SectionShell>

  <SectionShell sectionClass="section-home-projects" reveal={false}>
    <div class="home-projects-intro" data-reveal>
      <SectionHeading as="h2" variant="display-lg" uppercase class="projects-heading">Featured projects</SectionHeading>
      <p class="lead-text lead-text--md">
        See how our innovative, hands-on approach has helped brands like yours grow fanbases, generate buzz, and
        break records.
      </p>
      <Button href="/projects" variant="secondary">See more</Button>
    </div>
    {
      featuredProjects.length > 0 && (
        <ul class="home-projects-grid">
          {featuredProjects.map((project, projectIndex) => (
            <li
              class:list={['home-project-preview-item', { featured: projectIndex === 0 }]}
              data-reveal
              data-reveal-delay={String(projectIndex * 90)}
            >
              <a href={project.href} class="home-project-preview-image-wrapper">
                <Image src={project.image} alt={project.imageAlt} class="image-cover" />
              </a>
              <div class="home-project-preview-content">
                <a href={project.href} class="home-project-preview-title-link">
                  <SectionHeading as="h3" variant={projectIndex === 0 ? 'h2' : 'h3'} uppercase>
                    {project.title}
                  </SectionHeading>
                </a>
                <p class="home-project-preview-meta">{project.client}</p>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </SectionShell>

  <section class="section-home-how surface-ink">
    <div class="page-padding">
      <div class="container-xxlarge how-inner" data-reveal>
        <Eyebrow class="how-eyebrow">How we work</Eyebrow>
        <SectionHeading as="h2" variant="display-xl" class="how-heading">
          PEOPLE SHARE WHAT THEY LOVE. GAMERS AREN'T ANY DIFFERENT.
        </SectionHeading>
        <p class="lead-text how-copy">
          Gamers aren't dumb. They know when they're being played, and when their favorite streamers are being paid to
          fake fandom. It shows. We use our deep community roots to connect brands with influencers who will actually
          appreciate them – and share those brands with their friends.
        </p>
      </div>
    </div>
  </section>

  <ValuesList items={valuesItems} portraitAlt="Portrait photo representing the Leviathan Core team" />

  <ContactCTA
    headingText={"IT'S TIME TO FIND\nYOUR FANDOM"}
    headingLevel="h2"
    tagline="We can help. With PLANNING, NEGOTIATIONS, execution – the works."
  />
</BaseLayout>

<style>
  .lead-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    line-height: var(--lh-loose);
  }
  .lead-text--md {
    font-size: var(--fs-lg);
    line-height: var(--lh-looser);
  }

  /* ---------- Hero: full-bleed media plane + brand-forward copy ---------- */
  .section-home-hero {
    margin-inline: calc(-1 * var(--frame-padding));
    margin-top: calc(-1 * var(--frame-padding));
  }

  .home-hero-plane {
    position: relative;
    min-height: min(92vh, 920px);
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--color-ink-band);
  }

  .home-hero-media {
    position: absolute;
    inset: 0;
  }

  .home-hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .home-hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        color-mix(in srgb, var(--color-ink-band) 88%, transparent) 0%,
        color-mix(in srgb, var(--color-ink-band) 55%, transparent) 42%,
        color-mix(in srgb, var(--color-ink-band) 18%, transparent) 72%,
        transparent 100%
      ),
      linear-gradient(0deg, color-mix(in srgb, var(--color-ink-band) 55%, transparent), transparent 45%);
  }

  .home-hero-copy-wrap {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: clamp(5.5rem, 14vh, 8rem) clamp(3rem, 8vh, 5rem);
  }

  .home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 38rem;
    color: var(--color-on-ink);
  }

  .brand-mark {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    letter-spacing: var(--ls-display);
    line-height: 1;
  }

  :global(.hero-eyebrow) {
    margin: 0;
    opacity: 0.7;
    color: var(--color-on-ink);
  }

  .hero-heading {
    max-width: 11ch;
    color: var(--color-on-ink);
  }

  .hero-intro {
    max-width: var(--measure-lead);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    color: color-mix(in srgb, var(--color-on-ink) 82%, transparent);
  }

  :global(a.hero-cta.button) {
    margin-top: 0.5rem;
    background: var(--color-on-ink);
    color: var(--color-ink);
    border-color: var(--color-on-ink);
  }

  @media screen and (max-width: 767px) {
    .home-hero-plane {
      min-height: min(88vh, 780px);
    }
    .hero-heading {
      max-width: none;
    }
  }

  /* ---------- Services ---------- */
  .home-services-grid {
    display: grid;
    grid-template-columns: minmax(14rem, 0.9fr) minmax(0, 1.4fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  @media screen and (max-width: 991px) {
    .home-services-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .home-services-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
    position: sticky;
    top: 6rem;
  }

  .services-heading {
    max-width: 10ch;
  }

  .home-services-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  @media screen and (max-width: 767px) {
    .home-services-list {
      grid-template-columns: 1fr;
    }
    .home-services-intro {
      position: static;
    }
  }

  .home-services-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 1.35rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  @media screen and (min-width: 768px) {
    .home-services-item:nth-child(odd) {
      padding-left: 0;
      border-right: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    }
    .home-services-item:nth-child(-n + 2) {
      border-top: 0;
      padding-top: 0;
    }
  }

  .home-services-item :global(.service-icon) {
    width: 2.75rem;
    height: 2.75rem;
  }

  .service-item-title {
    margin-bottom: 0.4rem;
  }

  .service-item-description {
    margin: 0;
    max-width: 32ch;
    font-family: var(--font-body);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  /* ---------- Featured projects ---------- */
  .home-projects-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    max-width: 36rem;
  }

  .projects-heading {
    max-width: 12ch;
  }

  .home-projects-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr;
    gap: clamp(1.25rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (max-width: 991px) {
    .home-projects-grid {
      grid-template-columns: 1fr;
    }
  }

  .home-project-preview-item {
    display: flex;
    flex-direction: column;
  }

  .home-project-preview-image-wrapper {
    display: block;
    margin-bottom: 0.9rem;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-paper-deep);
  }

  .home-project-preview-item:not(.featured) .home-project-preview-image-wrapper {
    aspect-ratio: 3 / 4;
  }

  .home-project-preview-image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-editorial);
  }

  @media (hover: hover) and (min-width: 992px) {
    .home-project-preview-item:hover .home-project-preview-image-wrapper :global(img) {
      transform: scale(1.04);
    }
  }

  .home-project-preview-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .home-project-preview-title-link {
    color: inherit;
    text-decoration: none;
  }

  .home-project-preview-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    opacity: 0.55;
  }

  /* ---------- How we work (ink band) ---------- */
  .section-home-how {
    margin-inline: calc(-1 * var(--frame-padding));
    padding: var(--section-pad-y) var(--frame-padding);
  }

  .how-inner {
    max-width: 52rem;
  }

  :global(.how-eyebrow) {
    margin-bottom: 1rem;
    color: var(--color-on-ink);
    opacity: 0.6;
  }

  :global(.how-heading) {
    max-width: 16ch;
    margin-bottom: 1.5rem;
    color: var(--color-on-ink);
  }

  .how-copy {
    max-width: 40rem;
    color: color-mix(in srgb, var(--color-on-ink) 78%, transparent);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
  }
</style>

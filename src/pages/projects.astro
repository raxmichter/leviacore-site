---
/**
 * Projects page (`/projects`) — editorial portfolio index.
 */
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Cursor from '../components/Cursor.astro'
import SectionShell from '../components/SectionShell.astro'
import SectionHeading from '../components/SectionHeading.astro'
import ProjectCard from '../components/ProjectCard.astro'

const isProd = import.meta.env.PROD
const entries = await getCollection('projects', (entry) => !isProd || !entry.data.draft)

const projects = entries
  .sort((a, b) => {
    const orderA = a.data.order ?? Number.POSITIVE_INFINITY
    const orderB = b.data.order ?? Number.POSITIVE_INFINITY
    if (orderA !== orderB) return orderA - orderB
    return b.data.year - a.data.year
  })
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.services,
    image: entry.data.heroImage,
    imageAlt: entry.data.heroImageAlt,
    href: `/project/${entry.id}`,
  }))
---

<BaseLayout
  title="Projects | Leviathan Core"
  description="Driving results that matter. We've innovated to help brands and titles break through and make waves with the right audiences again and again. These featured stories are just a few of our favorites."
  canonicalPath="/projects"
>
  <Cursor />

  <SectionShell sectionClass="section-work-hero" withTopDivider={false}>
    <div class="work-hero-grid">
      <SectionHeading as="h1" variant="display-2xl" class="work-hero-heading">
        Driving Results That Matter
      </SectionHeading>
      <p class="lead-text">
        We've innovated to help brands and titles break through and make waves with the right audiences again and
        again. These featured stories are just a few of our favorites.
      </p>
    </div>
  </SectionShell>

  {
    projects.length > 0 && (
      <section class="section-work-projects">
        <div class="page-padding">
          <div class="container-xxlarge">
            <div class="work-projects-list">
              {projects.map((project, index) => (
                <div class="work-projects-item">
                  <ProjectCard
                    title={project.title}
                    description={project.description}
                    tags={project.tags}
                    image={project.image}
                    imageAlt={project.imageAlt}
                    href={project.href}
                    mediaFirst={index % 2 === 1}
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .lead-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    line-height: var(--lh-loose);
    max-width: var(--measure-lead);
    color: var(--color-text-muted);
  }

  .work-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: end;
  }

  @media screen and (max-width: 991px) {
    .work-hero-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      align-items: start;
    }
  }

  .work-hero-heading {
    margin: 0;
    max-width: 12ch;
  }

  .work-projects-list {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-xl);
  }

  .work-projects-item {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .work-projects-item:first-child {
    border-top: none;
  }
</style>

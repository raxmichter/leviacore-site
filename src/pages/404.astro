---
/**
 * 404 — editorial utility page.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionShell from '../components/SectionShell.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Eyebrow from '../components/Eyebrow.astro'
import Button from '../components/Button.astro'
---

<BaseLayout
  title="Page Not Found | Leviathan Core"
  description="The page you're looking for doesn't exist or has moved."
  canonicalPath="/404"
  noindex
>
  <SectionShell sectionClass="section-utility" withTopDivider={false}>
    <div class="utility-inner">
      <Eyebrow>404</Eyebrow>
      <SectionHeading as="h1" variant="display-xl" class="utility-heading">Page not found</SectionHeading>
      <Button href="/">Back to Homepage</Button>
    </div>
  </SectionShell>
</BaseLayout>

<style>
  .utility-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    min-height: min(70vh, 640px);
    justify-content: center;
    padding-block: var(--space-3xl);
  }
  .utility-heading {
    margin: 0;
    max-width: 10ch;
  }
</style>

---
/**
 * 404 — Phase C2b.
 *
 * Port of _webflow-export/404.html. Astro emits this to dist/404.html, which both
 * Cloudflare Pages and Netlify serve automatically for unmatched routes.
 *
 * Two deliberate departures from the source, both fixes rather than preferences:
 *
 * 1. The source's page heading is an <h2> with no <h1> anywhere on the page — a
 *    heading-order defect and an axe finding. Rebuilt as the page's <h1>. The "404"
 *    text above it stays a non-heading meta line, as in the source.
 *
 * 2. The source's <title> is the bare "Not Found", inconsistent with every other
 *    page's "X | Leviathan Core" pattern. Brought into house style.
 *
 * Note on 401: the export also ships 401.html, Webflow's password-protection page.
 * It is NOT migrated — see build-context/DECISIONS.md. It posts to /.wf_auth, a
 * Webflow platform endpoint that does not exist on a static host, and no content on
 * this site is password-protected.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionShell from '../components/SectionShell.astro'
import SectionHeading from '../components/SectionHeading.astro'
import Eyebrow from '../components/Eyebrow.astro'
import Button from '../components/Button.astro'
---

<BaseLayout
  title="Page Not Found | Leviathan Core"
  description="The page you're looking for doesn't exist or has moved."
  canonicalPath="/404"
  noindex
>
  <SectionShell sectionClass="section-utility" withTopDivider={false}>
    <div class="utility-inner">
      <Eyebrow>404</Eyebrow>
      <SectionHeading as="h1" variant="display-lg" class="utility-heading">Page not found</SectionHeading>
      <Button href="/">Back to Homepage</Button>
    </div>
  </SectionShell>
</BaseLayout>

<style>
  .utility-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    /* Keeps the block off the header on tall viewports without pinning it to a
       fixed height, which would clip on short mobile screens. */
    padding-block: var(--space-4xl);
  }
  .utility-heading {
    margin: 0;
  }
</style>

---
/**
 * Blog article (`/blog/<slug>`) — Phase D3. Built and SHIPPED DISABLED.
 *
 * See build-context/DECISIONS.md ("Blog is built and DELIBERATELY DISABLED") and
 * docs/enable-blog.md before touching anything in this file's behaviour.
 *
 * GATE 4 of 6 (docs/enable-blog.md's six-gate checklist): route suppression.
 * `getStaticPaths()` returns `[]` whenever `features.blog` is false — the committed
 * value in src/config.ts — so zero `/blog/*` article routes are generated. No file
 * exists to redirect or noindex; the routes are simply never created. Unlike the
 * sibling index route (see `blog/[...page].astro` for why THAT file needed an
 * unusual filename), this file is already a genuinely dynamic route — bracketed
 * filenames are the one case where `getStaticPaths()` is confirmed to reliably gate
 * output in this Astro version, verified against actual build output for both the
 * enabled and disabled state.
 *
 * Layout derived once from _webflow-export/detail_post.html (the single authorized
 * exception to the never-read detail_*.html rule — build-context/PROGRESS.md), per
 * the build brief: the same hero-grid / content-grid shape the case study system
 * uses, minus the case-study-specific metadata block (client/year/timeline/
 * services/website — none of that applies to a blog post), plus publish date and
 * reading time, which the source's own post-hero-grid meta column already carries
 * (it also carries "Category", replaced here with the schema's `tags`).
 *
 * Grid ratio `.33fr 1fr 1px .33fr` and the vertical-divider-becomes-horizontal-line
 * idiom at <=991px are ported verbatim from tokens.md's documented `.post-hero-grid`
 * / `.post-content-grid` structure (the "dominant structural pattern" — see tokens.md
 * around its grid-template-columns catalogue) using the existing Divider component's
 * `hide-mobile-landscape` / `show-mobile-landscape` responsive pair, exactly as
 * detail_post.html itself pairs `.line-vertical.hide-mobile-landscape` with a sibling
 * `.line.show-mobile-landscape`.
 *
 * Dropped from the source layout: the "Share" social-badge row and the "Related
 * News" / newsletter sections below the article. All three bind to `href="#"` or an
 * empty CMS list in the source — non-functional placeholder markup, not live
 * functionality (the same reasoning SiteFooter already applies to the empty
 * webflow.com credit link). Not in this phase's scope to invent real destinations
 * for them.
 *
 * No hero-image motion: interactions.md lists "Blog Post Image Parallax" as dormant
 * and belonging to this template, but Phase E owns all motion. The image below
 * renders as a static `<Image>` — Phase E attaches the parallax later if it turns
 * out to share the sitewide Image Parallax primitive.
 */
import type { ImageMetadata } from 'astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import DisplayFigures from '../../components/DisplayFigures.astro'
import Button from '../../components/Button.astro'
import { features } from '../../config'

export async function getStaticPaths() {
  if (!features.blog) return []

  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { Content } = await render(post)

const publishDateDisplay = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
})

// Reading time: no dedicated field in the schema (per the brief, this is one of the
// two additions that replace the case-study metadata block). Computed from the raw
// markdown body at ~200 words/minute, floored at 1 minute so a very short post never
// reads "0 min read".
const wordCount = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length
const readingMinutes = Math.max(1, Math.round(wordCount / 200))

const heroImage: ImageMetadata | undefined = post.data.heroImage
---

<BaseLayout
  title={`${post.data.title} | Leviathan Core`}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
>
  <section class="section-post" data-reveal>
    <div class="page-padding">
      <div class="container-xxlarge">
        <div class="padding-vertical padding-xlarge">
          <div class="post-hero-grid">
            <div class="post-hero-back">
              <Button href="/blog" variant="secondary">Go Back</Button>
            </div>
            <div class="post-hero-heading-col">
              <SectionHeading as="h1" variant="display-xl" class="post-title">
                <DisplayFigures text={post.data.title} />
              </SectionHeading>
              <p class="post-lead">{post.data.description}</p>
              <div class="post-hero-meta">
                <p class="post-meta-inline">
                  <span>{publishDateDisplay}</span>
                  <span aria-hidden="true">·</span>
                  <span>{readingMinutes} min read</span>
                  {
                    post.data.tags.length > 0 && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{post.data.tags.join(', ')}</span>
                      </>
                    )
                  }
                </p>
              </div>
            </div>
          </div>
        </div>

        {
          heroImage && (
            <div class="post-image-wrapper">
              <Image src={heroImage} alt={post.data.heroImageAlt ?? post.data.title} class="image-cover" />
            </div>
          )
        }

        <div class="padding-vertical padding-xlarge">
          <div class="post-content-grid">
            <div class="text-rich-text">
              <Content />
            </div>
            <div class="post-content-sidebar">
              <p class="post-meta-label">Author</p>
              <SectionHeading as="h3" variant="h4">{post.data.author}</SectionHeading>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .padding-vertical.padding-xlarge {
    padding-block: var(--section-pad-y);
  }

  .post-hero-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  @media screen and (max-width: 991px) {
    .post-hero-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .post-hero-heading-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
  }
  .post-title {
    margin-bottom: 0;
  }
  .post-lead {
    margin: 0;
    max-width: var(--measure-lead);
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    line-height: var(--lh-loose);
    color: var(--color-text-muted);
  }

  .post-meta-inline {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .post-meta-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .post-image-wrapper {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    margin-inline: calc(-1 * var(--page-padding));
    overflow: hidden;
    height: min(48vw, 640px);
    background: var(--color-paper-deep);
  }
  @media screen and (max-width: 767px) {
    .post-image-wrapper {
      height: 55vw;
    }
  }
  .post-image-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 0.35fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
    max-width: 56rem;
  }
  @media screen and (max-width: 991px) {
    .post-content-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .post-content-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }

  /* ---------- Rich-text prose ----------
     Same prose ruleset privacy-policy.astro established for its Markdown body, plus a
     blockquote rule (not needed there, but documented for `.text-rich-text` generally in
     tokens.md §2c/§4c) since article bodies are freer-form than legal text. Link color/
     underline inside `.text-rich-text` already comes from global.css — not repeated here. */
  .text-rich-text :global(p) {
    margin-top: var(--space-sm);
  }
  .text-rich-text :global(> :first-child) {
    margin-top: 0;
  }
  .text-rich-text :global(h2),
  .text-rich-text :global(h3),
  .text-rich-text :global(h4) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }
  .text-rich-text :global(ul),
  .text-rich-text :global(ol) {
    margin-top: var(--space-sm);
    padding-left: 1.5em;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }
  .text-rich-text :global(ul) {
    list-style: disc;
  }
  .text-rich-text :global(ol) {
    list-style: decimal;
  }
  .text-rich-text :global(li) {
    display: list-item;
  }
  .text-rich-text :global(blockquote) {
    margin: var(--space-md) 0;
    padding-left: var(--space-md);
    border-left: var(--divider-width) solid var(--color-ink-pure);
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: 2rem; /* tokens.md §2c — .text-rich-text blockquote base size, no dedicated token */
    line-height: var(--lh-relaxed);
  }
  @media screen and (max-width: 767px) {
    .text-rich-text :global(blockquote) {
      font-size: 1.5rem;
    }
  }
  @media screen and (max-width: 479px) {
    .text-rich-text :global(blockquote) {
      font-size: 1.75rem; /* larger than the <=767 step — same inversion tokens.md HIGH-1
        documents for .heading-small, reproduced here per tokens.md §4c's note that the
        blockquote follows the identical pattern. */
    }
  }
  .text-rich-text :global(figcaption) {
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
</style>

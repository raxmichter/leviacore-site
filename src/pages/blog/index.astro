---
/**
 * Blog index (`/blog`) — Phase D3. Built and SHIPPED DISABLED.
 *
 * See build-context/DECISIONS.md ("Blog is built and DELIBERATELY DISABLED") and
 * docs/enable-blog.md before touching anything in this file's behaviour.
 *
 * GATE 3 of 6 (docs/enable-blog.md's six-gate checklist): route suppression.
 * `getStaticPaths()` returns `[]` whenever `features.blog` is false — which is the
 * committed value in src/config.ts. Confirmed empirically (not assumed): a static,
 * non-dynamic page file that exports `getStaticPaths` and returns `[]` is skipped by
 * Astro's build entirely — no route is registered, no HTML is emitted, `dist/blog/`
 * does not exist. This is not "render then hide"; the page function never runs past
 * the guard.
 *
 * When enabled, this mirrors projects.astro's hero + card-grid shape exactly, and
 * reuses ProjectCard.astro rather than inventing a parallel BlogCard component — a
 * post summary (title/description/tags/image/href) is the same shape as a project
 * summary. ProjectCard is only imported here, never edited (D3 does not own it).
 *
 * Posts without a `heroImage` are filtered out of the grid: ProjectCard requires an
 * image, and `heroImage` is intentionally optional at the schema level (not every
 * post need have one) — so a post that omits it simply doesn't appear as a card
 * until it has one. docs/enable-blog.md calls this out for anyone adding real posts.
 */
import type { ImageMetadata } from 'astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionShell from '../../components/SectionShell.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { features } from '../../config'

export async function getStaticPaths() {
  if (!features.blog) return []
  return [{ params: {} }]
}

const allPosts = await getCollection('blog', ({ data }) => !data.draft)

const posts = allPosts
  .filter((post): post is typeof post & { data: { heroImage: ImageMetadata } } =>
    Boolean(post.data.heroImage),
  )
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
---

<BaseLayout
  title="Blog | Leviathan Core"
  description="Insights, updates, and behind-the-scenes stories from the Leviathan Core team."
  canonicalPath="/blog"
>
  <SectionShell sectionClass="section-blog-hero" withTopDivider={false}>
    <div class="blog-hero-grid">
      <SectionHeading as="h1" variant="display-2xl" class="blog-hero-heading">
        News &amp; Insights
      </SectionHeading>
      <p class="lead-text">
        Updates, perspectives, and behind-the-scenes stories from the team connecting brands and
        audiences in the gaming space.
      </p>
    </div>
  </SectionShell>

  {
    posts.length > 0 && (
      <section class="section-blog-posts">
        <div class="page-padding">
          <div class="container-xxlarge">
            <div class="blog-posts-list">
              {posts.map((post) => (
                <div class="blog-posts-item">
                  <ProjectCard
                    title={post.data.title}
                    description={post.data.description}
                    tags={post.data.tags}
                    image={post.data.heroImage}
                    imageAlt={post.data.heroImageAlt ?? post.data.title}
                    href={`/blog/${post.id}`}
                    ctaText="Read Article"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .lead-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    line-height: var(--lh-loose);
    max-width: var(--width-lg);
  }

  .blog-hero-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .blog-hero-heading {
    /* Source: `margin-bottom margin-xxhuge` around the heading resolves to a frozen 1rem in
       that two-class combo (tokens.md BLOCKER-2), not the nominal --space-5xl (12rem) — same
       resolved value projects.astro uses for its own hero heading. */
    margin-bottom: 1rem;
    max-width: var(--width-2xl);
  }

  .page-padding {
    padding-inline: var(--page-padding);
  }
  .container-xxlarge {
    width: 100%;
    max-width: var(--container-3xl);
    margin-inline: auto;
  }
  .blog-posts-list {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-xl);
  }
  .blog-posts-item {
    padding-block: var(--space-lg);
    border-top: var(--divider-width) solid var(--divider-color);
  }
  .blog-posts-item:first-child {
    border-top: none;
  }
</style>

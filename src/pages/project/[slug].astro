---
/**
 * `/project/[slug]` — the case study detail template. Phase D1.
 *
 * ⚠️ Note the singular `project` path segment — the plural `/projects` is the index page.
 * URL parity is the one non-negotiable rule of this migration: the slug IS the live URL
 * (e.g. `/project/warframe`). Slugs come from the file names D2 adds under
 * `src/content/projects/*.md` (the content layer's default id generator — see
 * `content.config.ts`); nothing here normalizes, prefixes, or prettifies them.
 *
 * Source: `_webflow-export/detail_project.html`, read once. The export's CMS fields are all
 * empty (Webflow strips Collection content from static exports), but the layout structure is
 * intact and is what's rebuilt here:
 *   1. Hero — title + subtitle on the left, a vertical divider, then a metadata list
 *      (Client / Year / Timeline / Services / Website) on the right.
 *   2. Content — Challenge/Solution copy on the left, a vertical divider, [gallery] on the
 *      right.
 *   3. Closing CTA — heading + icon on the left, tagline + button on the right.
 *
 * Two deliberate departures from the literal source markup, both because the schema (fixed,
 * not redefined here per the brief) shapes the content differently than the empty export
 * could show:
 *
 * - **Hero image.** The source's `section-project-hero` grid contains no `<img>` at all in the
 *   export — a Webflow CMS "image" field bound as a `background-image` inline style vanishes
 *   entirely (not just empty-`src`) when the export has no bound value, unlike the `w-dyn-bind-
 *   empty` markers left behind elsewhere. The schema (and the migration plan's own case-study
 *   shape: "...Metrics, hero image, CTA") requires `heroImage`/`heroImageAlt`, so it renders as
 *   a full-width banner directly below the hero grid — the standard place for it in this exact
 *   card pattern (compare `ProjectCard`'s cover image). Flagged here as a page-local addition,
 *   not a literal port.
 * - **Challenge/Solution icons dropped.** The source binds Challenge and Solution as two
 *   *separate* rich-text fields, each with its own icon (icon-05/icon-06). The schema and the
 *   governing migration plan instead give one Markdown body per case study ("Body holds
 *   Challenge and Solution copy"), rendered as a single `.text-rich-text` flow — so there's no
 *   per-field seam left to hang a per-heading icon on without parsing the rendered output. The
 *   icons are decorative only (no information loss), so they're omitted rather than faked.
 *
 * Corrected post-D1 (Phase D2, against the real captured pages): the live pages carry BOTH the
 * "Metrics that Matter" stat block AND an image gallery — D1 built against
 * `detail_project.html`, whose CMS fields (metrics text and the gallery) were both stripped by
 * the static export, so the gallery column looked empty and D1 repurposed it for metrics. Real
 * content restores the source's actual structure: metrics stay in the left column, stacked
 * after the Challenge/Solution copy (matching the live DOM, where the "Metrics that Matter"
 * heading and list sit inside `.project-content-grid-left-inner` alongside Challenge/Solution);
 * the gallery renders in the right column, exactly where the source's `w-dyn-list` was. Reading
 * order is therefore Challenge, Solution, Metrics that Matter, gallery — matching the live page.
 *
 * The closing CTA is built page-local rather than via `ContactCTA` — that component's shape
 * (eyebrow + heading + tagline + social row + embedded `ContactForm`) doesn't match this
 * section's actual markup (heading + decorative icon on the left; a one-line tagline + single
 * button on the right, no form, no social row). Forcing it through `ContactCTA`'s prop surface
 * would mean inventing a form/social presence the source page doesn't have here. `ContactCTA`
 * is off-limits to edit this phase anyway (blog agent owns nav/shared-component concerns
 * concurrently) — this mirrors how `privacy-policy.astro` built its own local section instead
 * of stretching `SectionShell`'s siblings.
 */
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import SectionShell from '../../components/SectionShell.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import DisplayFigures from '../../components/DisplayFigures.astro'
import Eyebrow from '../../components/Eyebrow.astro'
import Button from '../../components/Button.astro'
import icon02 from '../../assets/images/icon-02.svg'
// Decorative section icons, restored in Phase G. Source binds these at 60px wide:
// icon-05 above Challenge, icon-06 above Solution, icon-07 above Metrics that Matter.
// Marked alt="" — they carry no information the adjacent heading doesn't.
import iconChallenge from '../../assets/images/icon-05.svg'
import iconSolution from '../../assets/images/icon-06.svg'
import iconMetrics from '../../assets/images/icon-07.svg'

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD
  const entries = await getCollection('projects', (entry) => !isProd || !entry.data.draft)
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const { title, client, year, timeline, services, website, websiteLabel, heroImage, heroImageAlt, metrics, gallery, description } =
  entry.data
---

<BaseLayout title={`${title} | Leviathan Core`} description={description} canonicalPath={`/project/${entry.id}`}>
  <SectionShell sectionClass="section-project-hero" withTopDivider={false}>
    <div class="project-hero-grid">
      <div class="project-hero-intro">
        <SectionHeading as="h1" variant="display-lg" uppercase class="project-title">
          <DisplayFigures text={title} />
        </SectionHeading>
        <p class="project-subtitle">{description}</p>
      </div>
      <dl class="project-meta">
        <div class="project-meta-item">
          <dt class="project-meta-label">Client</dt>
          <dd class="project-meta-value">{client}</dd>
        </div>
        <div class="project-meta-item">
          <dt class="project-meta-label">Year</dt>
          <dd class="project-meta-value">{year}</dd>
        </div>
        <div class="project-meta-item">
          <dt class="project-meta-label">Timeline</dt>
          <dd class="project-meta-value">{timeline}</dd>
        </div>
        <div class="project-meta-item">
          <dt class="project-meta-label">Services</dt>
          <dd class="project-meta-value">
            <ul class="project-services-list">
              {services.map((service) => <li class="text-meta-link">{service}</li>)}
            </ul>
          </dd>
        </div>
        {
          website && (
            <div class="project-meta-item">
              <dt class="project-meta-label">Website</dt>
              <dd class="project-meta-value">
                <a href={website} class="text-meta-link" target="_blank" rel="noopener">
                  {websiteLabel ?? `${title} Website`}
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </div>
    {/*
      No full-width hero banner here. An earlier revision rendered `heroImage` as a
      band across the page below the hero grid — that was invented, not ported: the
      export's CMS image field vanished entirely so there was nothing to copy.

      The live layout puts the key art at the TOP OF THE RIGHT COLUMN of the content
      grid below, alongside the left-stacked Challenge / Solution / Metrics. Because
      `gallery[0]` IS the hero image in every case study's frontmatter, rendering the
      gallery in that column reproduces it exactly. `heroImage` remains a required
      schema field — it is what /projects and the homepage teaser use for cards.
    */}
  </SectionShell>

  <SectionShell sectionClass="section-project-content">
    <div class:list={['project-content-grid', { 'project-content-grid--solo': !gallery || gallery.length === 0 }]}>
      <div class="project-content-left">
        {/*
          The decorative icons above CHALLENGE and SOLUTION are restored here.
          D1 dropped them because the schema gives one Markdown body per case study,
          leaving no per-field seam to hang them on — but they don't need a seam:
          the two `##` headings are the first and second `h2` in this flow, so the
          icons attach via ::before with the URLs passed down as custom properties.
          Source sizes them at 60px wide (icon-05 Challenge, icon-06 Solution).
        */}
        <div
          class="text-rich-text has-section-icons"
          style={`--icon-challenge: url(${iconChallenge.src}); --icon-solution: url(${iconSolution.src})`}
        >
          <Content />
        </div>
        {
          metrics && metrics.length > 0 && (
            <div class="project-metrics">
              <Image src={iconMetrics} alt="" aria-hidden="true" width={60} class="section-icon" />
              <SectionHeading as="h2" variant="h4" uppercase class="metrics-heading">
                Metrics that Matter
              </SectionHeading>
              <ul class="project-metrics-list">
                {metrics.map((metric) => (
                  <li class="project-metric">
                    <span class="project-metric-value">{metric.value}</span>
                    <span class="project-metric-label">{metric.label}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      {
        gallery && gallery.length > 0 && (
          <div class="project-gallery">
            {gallery.map((item, index) => (
              <div class:list={['project-gallery-item', { featured: index === 0 }]}>
                <Image src={item.src} alt={item.alt} class="image-cover" />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </SectionShell>

  <section class="section-cta-contact surface-ink">
    <div class="page-padding">
      <div class="container-xxlarge">
        <div class="cta-contact-grid">
          <div class="cta-contact-grid-left">
            <div class="cta-heading-group">
              <Eyebrow class="cta-eyebrow">Contact</Eyebrow>
              <SectionHeading as="h2" variant="display-xl" uppercase class="cta-heading">
                It's time to find your fandom
              </SectionHeading>
            </div>
            <Image src={icon02} alt="Campaigns icon" class="cta-icon" />
          </div>
          <div class="cta-contact-grid-right">
            <p class="cta-tagline">
              The gaming industry has never been deeper or more complex. We can help. With negotiations, planning,
              execution – the works.
            </p>
            <Button href="/contact" variant="inverse" class="cta-button">Let's make it happen</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .project-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }
  @media screen and (max-width: 767px) {
    .project-hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: start;
    }
  }

  .project-hero-intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .project-title {
    max-width: 14ch;
  }
  .project-subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    line-height: var(--lh-loose);
    max-width: var(--measure-lead);
    color: var(--color-text-muted);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
  }
  .project-meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .project-meta-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .project-meta-value {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-mono-md);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .project-services-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    column-gap: var(--space-sm);
    row-gap: var(--space-tiny);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .text-meta-link {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--color-ink);
  }
  a.text-meta-link {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .project-content-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .project-content-grid--solo {
    grid-template-columns: 1fr;
  }
  @media screen and (max-width: 991px) {
    .project-content-grid {
      grid-template-columns: 1fr;
    }
  }

  .project-content-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .text-rich-text {
    max-width: 40rem;
  }
  .text-rich-text :global(h2) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    line-height: var(--lh-normal);
    text-transform: uppercase;
  }
  .text-rich-text :global(> :first-child) {
    margin-top: 0;
  }
  .text-rich-text :global(p) {
    margin-top: var(--space-sm);
    font-family: var(--font-body);
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .text-rich-text :global(> p:first-child) {
    margin-top: 0;
  }
  .text-rich-text :global(ul),
  .text-rich-text :global(ol) {
    margin-top: var(--space-sm);
    padding-left: 1.5em;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }
  .text-rich-text :global(ul) {
    list-style: disc;
  }
  .text-rich-text :global(ol) {
    list-style: decimal;
  }
  .text-rich-text :global(li) {
    display: list-item;
  }

  .project-metrics {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }
  .metrics-heading {
    margin: 0;
  }

  .section-icon {
    inline-size: 48px;
    block-size: auto;
    margin-bottom: var(--space-xs);
  }

  .has-section-icons :global(h2)::before {
    content: '';
    display: block;
    inline-size: 48px;
    block-size: 48px;
    margin-bottom: var(--space-xs);
    background: var(--icon-challenge) no-repeat center / contain;
  }

  .has-section-icons :global(h2:nth-of-type(2))::before {
    background-image: var(--icon-solution);
  }
  .project-metrics-list {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-metric {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .project-metric-value {
    font-family: var(--font-body);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: var(--lh-tighter);
    letter-spacing: var(--ls-display);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .project-metric-label {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-xs);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .project-gallery-item {
    overflow: hidden;
    background: var(--color-paper-deep);
  }
  .project-gallery-item.featured {
    aspect-ratio: 4 / 5;
  }
  .project-gallery-item:not(.featured) {
    aspect-ratio: 16 / 10;
  }
  .project-gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-cta-contact {
    margin-inline: calc(-1 * var(--frame-padding));
    margin-bottom: calc(-1 * var(--space-sm));
    padding: var(--section-pad-y) var(--frame-padding) calc(var(--section-pad-y) + var(--space-sm));
  }
  .cta-contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }
  @media screen and (max-width: 991px) {
    .cta-contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  .cta-contact-grid-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .cta-heading-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cta-eyebrow {
    margin: 0;
    color: var(--color-on-ink);
    opacity: 0.65;
  }
  .cta-heading {
    margin: 0;
    max-width: 12ch;
    color: var(--color-on-ink);
  }
  .cta-contact-grid-left :global(.cta-icon) {
    width: 5rem;
    height: auto;
    opacity: 0.85;
    filter: invert(1);
  }
  .cta-contact-grid-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .cta-tagline {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-xl);
    line-height: var(--lh-loose);
    max-width: 28ch;
    color: color-mix(in srgb, var(--color-on-ink) 78%, transparent);
  }
</style>

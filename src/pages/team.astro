---
/**
 * /team — editorial studio roster.
 */
import { load } from 'js-yaml'
import type { ImageMetadata } from 'astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import Cursor from '../components/Cursor.astro'
import SectionShell from '../components/SectionShell.astro'
import SectionHeading from '../components/SectionHeading.astro'
import TeamMemberCard from '../components/TeamMemberCard.astro'
import ValuesList from '../components/ValuesList.astro'

import teamYamlRaw from '../data/team.yaml?raw'

interface TeamMemberRecord {
  name: string
  role: string
  image: string
  alt: string
  hiring?: boolean
}

const team = load(teamYamlRaw) as TeamMemberRecord[]

const imageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*', {
  eager: true,
})

function resolveImage(filename: string): ImageMetadata {
  const mod = imageModules[`../assets/images/${filename}`]
  if (!mod) {
    throw new Error(`team.yaml references missing image: ${filename}`)
  }
  return mod.default
}

const valuesItems = [
  {
    number: '01',
    title: 'AUTHENTICITY',
    description:
      'This crew loves what we do. It helps us push harder, and we love working with brands and communities that feel the same way.',
  },
  {
    number: '02',
    title: 'TRANSPARENCY',
    description:
      "Blame it on our Midwestern roots, but we believe in the power of integrity. We'll always give it to you straight, and never keep you in the dark.",
  },
  {
    number: '03',
    title: 'ADAPTIVITY',
    description:
      "Stop innovating in the gaming realm and you'll become irrelevant. We'd rather be irreplaceable by adapting to every challenge that comes our way.",
  },
  {
    number: '04',
    title: 'TEAMWORK',
    description:
      "Building games is a team sport. So is building fanbases. Collaboration isn't just smart, it makes the process more fun and enjoyable for everyone.",
  },
]
---

<BaseLayout
  title="Team | Leviathan Core"
  description="Meet the team that makes it happen. We’re a talented, passionate group that loves what we do – helping brands build influence with creators and fanbases in the gaming community."
  canonicalPath="/team"
>
  <Cursor />

  <SectionShell sectionClass="section-studio-hero" withTopDivider={false}>
    <div class="studio-hero">
      <SectionHeading as="h1" variant="display-2xl" class="hero-heading">
        Meet the team that makes it happen.
      </SectionHeading>
      <p class="text-size-large">
        We’re a talented, passionate group that loves what we do – helping brands build influence
        with creators and fanbases in the gaming community.
      </p>
    </div>
  </SectionShell>

  <SectionShell sectionClass="section-studio-team" reveal={false}>
    <div class="studio-team-grid">
      <div class="studio-team-intro" data-reveal>
        <SectionHeading as="h2" variant="h1" uppercase class="intro-heading">Our Team</SectionHeading>
        <p class="text-size-large">
          When you’re lucky enough to do what you love, we believe in giving it your absolute
          best. Each of us brings unique skills and perspectives to the table, and we’re
          committed to doing so with the utmost level of professionalism and integrity.
        </p>
      </div>
      <div class="team-grid">
        {
          team.map((member) => (
            <TeamMemberCard
              name={member.name}
              role={member.role}
              image={resolveImage(member.image)}
              alt={member.alt}
              hiring={member.hiring}
            />
          ))
        }
      </div>
    </div>
  </SectionShell>

  <ValuesList
    items={valuesItems}
    portraitAlt="Portrait photo representing the Leviathan Core team"
  />
</BaseLayout>

<style>
  .studio-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: end;
  }

  @media screen and (max-width: 991px) {
    .studio-hero {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      align-items: start;
    }
  }

  .hero-heading {
    max-width: 14ch;
    margin: 0;
  }

  .text-size-large {
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    line-height: var(--lh-looser);
    color: var(--color-text-muted);
    max-width: 34ch;
  }

  .studio-team-grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media screen and (max-width: 991px) {
    .studio-team-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .studio-team-intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 6rem;
  }

  @media screen and (max-width: 991px) {
    .studio-team-intro {
      position: static;
    }
  }

  .intro-heading {
    max-width: 8ch;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media screen and (max-width: 767px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

# Security and caching headers — Netlify / Cloudflare Pages `_headers` format.
#
# A static site has no server, no database and no admin login, so most of the
# attack surface does not exist. These headers cover what remains.
#
# ⚠️ CTO: verify these at the edge after cutover. Header syntax is host-specific
# and a misapplied CSP breaks the site silently for users while looking fine to
# whoever deployed it. Test with the real deployment before pointing DNS.

/*
  # Clickjacking. The site is never framed by anything.
  X-Frame-Options: DENY
  # Stop browsers guessing content types.
  X-Content-Type-Options: nosniff
  # Send origin only on cross-origin requests; full path stays internal.
  Referrer-Policy: strict-origin-when-cross-origin
  # No page here uses any of these. Deny rather than leave to defaults.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # HSTS: 1 year, subdomains, preload-eligible.
  # ⚠️ Do NOT enable until HTTPS is confirmed working on every subdomain —
  # this is difficult to reverse once browsers have cached it.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  #
  # CSP. Deliberately explicit about what this site actually loads:
  #   - Google Analytics 4 (G-EG4F7ZLTZQ) — the only third-party script.
  #   - Fonts are SELF-HOSTED, so no font CDN is allowlisted. If a future change
  #     reintroduces Google Fonts, this will block it — that is intended.
  #   - 'unsafe-inline' for styles is required by Astro's scoped-style output.
  #     Scripts do NOT get 'unsafe-inline'.
  #   - form-action is 'self' today. WHEN A REAL CONTACT FORM ENDPOINT IS CHOSEN
  #     (OPEN.md item 2), ITS ORIGIN MUST BE ADDED HERE OR SUBMISSIONS WILL BE
  #     SILENTLY BLOCKED BY THE BROWSER.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; img-src 'self' data: https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Astro emits content-hashed filenames for these, so they are safe to cache
# permanently — a change produces a new filename.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
